/// One erasure ledger row per candidate. Holds step names and counts only, never candidate content.
model CandidateErasure {
  id                Int       @id @default(autoincrement())
  companyId         Int
  candidateId       Int
  /// PENDING, COMPLETED or PARTIAL. PARTIAL rows are retried.
  status            String    @default("PENDING")
  /// ADMIN_REQUEST, DELETION_QUEUE or RETENTION_POLICY.
  trigger           String
  attempts          Int       @default(0)
  completedSteps    String[]
  failedSteps       String[]
  requestedByUserId Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  candidate Candidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([companyId, candidateId])
  @@index([status, updatedAt])
}

/// A documented reason to keep a candidate's data. Retention expiry skips held candidates.
model RetentionHold {
  id             Int       @id @default(autoincrement())
  companyId      Int
  candidateId    Int
  reason         String
  placedByUserId Int
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?

  candidate Candidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, candidateId])
}

/// Recruiter spreadsheet import. Separate from Candidate and Application.
/// Preview does not create these rows. Confirmation does.
enum ApplicantImportStatus {
  CONFIRMED
  COMPLETED
  PARTIAL
  FAILED
}

enum ApplicantImportRowStatus {
  CREATED
  ATTACHED
  SKIPPED
  FAILED
}

model ApplicantImportTemplate {
  id              Int      @id @default(autoincrement())
  companyId       Int
  name            String
  mapping         Json
  createdByUserId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([companyId])
}

model ApplicantImportBatch {
  id               Int                   @id @default(autoincrement())
  companyId        Int
  jobId            Int
  createdByUserId  Int
  idempotencyKey   String
  fileSha256       String
  fileName         String
  status           ApplicantImportStatus @default(CONFIRMED)
  mapping          Json
  createdCount     Int                   @default(0)
  attachedCount    Int                   @default(0)
  skippedCount     Int                   @default(0)
  failedCount      Int                   @default(0)
  createdAt        DateTime              @default(now())
  completedAt      DateTime?

  company Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job     Job                  @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  rows    ApplicantImportRow[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, jobId])
}

model ApplicantImportRow {
  id                  Int                      @id @default(autoincrement())
  batchId             Int
  companyId           Int
  rowNumber           Int
  status              ApplicantImportRowStatus
  candidateId         Int?
  applicationId       Int?
  code                String
  name                String
  emailMasked         String?
  externalCandidateId String?

  batch ApplicantImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, rowNumber])
  @@index([companyId])
}

/// Job-specific inbound email route. The raw token is encrypted for the recruiter view and hashed for lookup.
enum InboundEmailStatus {
  RECEIVED
  PROCESSED
  REVIEW
  FAILED
  REJECTED
}

model InboundEmailRoute {
  id               Int      @id @default(autoincrement())
  companyId        Int
  jobId            Int
  tokenHash        String   @unique
  tokenCiphertext  String?
  enabled          Boolean  @default(true)
  createdByUserId  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job      Job                   @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  messages InboundEmailMessage[]

  @@unique([companyId, jobId])
  @@index([companyId])
}

model InboundEmailMessage {
  id               Int                @id @default(autoincrement())
  companyId        Int
  jobId            Int
  routeId          Int
  providerEventId  String             @unique
  status           InboundEmailStatus @default(RECEIVED)
  code             String?
  applicantName    String?
  emailMasked      String?
  /// Normalized address for a later authorized retry. Not written to audit logs.
  applicantEmailNormalized String?
  /// unavailable, clean, or infected. unavailable means no scanner is configured.
  malwareScan      String?
  attachmentCount  Int                @default(0)
  storageKey       String?
  applicationId    Int?
  candidateId      Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job     Job              @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  route   InboundEmailRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)

  @@index([companyId, jobId])
  @@index([status, updatedAt])
}
