generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum CandidateStatus {
  APPLIED
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  SYSTEM_DESIGN
  HR
}

enum CodingTestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

model Company {
  id        Int    @id @default(autoincrement())
  name      String
  industry  String
  employees Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates Candidate[]
  jobs       Job[]
}

model Job {
  id     Int       @id @default(autoincrement())
  title  String
  status JobStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int

  company      Company        @relation(fields: [companyId], references: [id])
  applications Application[]

  @@index([companyId, status])
}

model Candidate {
  id              Int             @id @default(autoincrement())
  name            String
  role            String
  experienceYears Int
  status          CandidateStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int

  company      Company        @relation(fields: [companyId], references: [id])
  applications Application[]

  @@index([companyId])
}

model Application {
  id Int @id @default(autoincrement())

  status ApplicationStatus @default(APPLIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateId Int
  jobId       Int

  candidate Candidate @relation(fields: [candidateId], references: [id])
  job        Job         @relation(fields: [jobId], references: [id])
  interviews Interview[]
  codingTests CodingTest[]
  reports     Report[]

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId, status])
}

model Interview {
  id          Int             @id @default(autoincrement())
  type        InterviewType
  interviewAt DateTime
  result      InterviewResult

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}

model CodingTest {
  id Int @id @default(autoincrement())

  title String

  score Int

  maxScore Int

  status CodingTestStatus

  takenAt DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}

model Report {
  id Int @id @default(autoincrement())

  recommendation Recommendation

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}
