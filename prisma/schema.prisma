  APPLIED
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  SYSTEM_DESIGN
  HR
}

enum CodingTestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AssessmentAttemptStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

enum RequirementLifecycle {
