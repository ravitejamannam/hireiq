generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum CandidateStatus {
  APPLIED
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  SYSTEM_DESIGN
  HR
}

enum CodingTestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

enum RequirementLifecycle {
  REQUIREMENT_DRAFTED
  CLIENT_NOTIFIED
  REQUIREMENT_POSTED
  INTERVIEWER_NOTIFIED
  SOURCING_SHORTLISTING
  BILLING_GENERATED
}

enum RoleCategory {
  ENGINEERING
  SALES
  DESIGN
  FINANCE
}

enum SourcingDatabaseSource {
  LINKEDIN
  NAUKRI
}

enum InterviewerAvailability {
  AVAILABLE
  NOT_AVAILABLE
}

enum InterviewerCategory {
  ENGINEERING
  DATA_SCIENCE
  PRODUCT
  DESIGN
}

enum ApplicationPipelineStatus {
  CV_POOL
  EXPERT_REVIEW
  TECH_EVALUATION
  SHORTLISTED
  SELECTED
  REJECTED
  HIRED
}

model Company {
  id        Int    @id @default(autoincrement())
  name      String
  industry  String
  employees Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates Candidate[]
  jobs       Job[]
}

model Job {
  id     Int       @id @default(autoincrement())
  title  String
  status JobStatus @default(OPEN)

  roleCategory        RoleCategory?
  experienceRange     String?
  location            String?
  compensationRange   String?
  targetHireDate      DateTime?
  numberOfPositions   Int?
  mustHaveRequirements String?
  niceToHaveRequirements String?
  jobDescription      String?
  evaluationCriteria  String?
  primarySkills       String?

  requirementLifecycle RequirementLifecycle @default(REQUIREMENT_DRAFTED)
  clientCompletedAt    DateTime?

  sourcingDatabaseSource SourcingDatabaseSource?
  sourcingAccessDetails  String?

  sourcingAccessReceivedAt DateTime?
  shortlistingDueAt        DateTime?
  shortlistingCompletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int
  assignedInterviewerId Int?

  company      Company        @relation(fields: [companyId], references: [id])
  assignedInterviewer Interviewer? @relation(fields: [assignedInterviewerId], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([companyId, status])
  @@index([assignedInterviewerId])
}

model Interviewer {
  id           Int                     @id @default(autoincrement())
  name         String
  category     InterviewerCategory
  availability InterviewerAvailability @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedJobs Job[]
}

model Candidate {
  id              Int             @id @default(autoincrement())
  name            String
  role            String
  experienceYears Int
  status          CandidateStatus
  location        String?
  currentEmployer String?
  skills          String?
  expectedCTC     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int

  company      Company        @relation(fields: [companyId], references: [id])
  applications Application[]

  @@index([companyId])
}

model Application {
  id Int @id @default(autoincrement())

  status ApplicationPipelineStatus @default(CV_POOL)
  source SourcingDatabaseSource?
  expertScore Int?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateId Int
  jobId       Int

  candidate Candidate @relation(fields: [candidateId], references: [id])
  job        Job         @relation(fields: [jobId], references: [id])
  interviews Interview[]
  codingTests CodingTest[]
  reports     Report[]

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId, status])
}

model Interview {
  id          Int             @id @default(autoincrement())
  type        InterviewType
  interviewAt DateTime
  result      InterviewResult

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}

model CodingTest {
  id Int @id @default(autoincrement())

  title String

  score Int

  maxScore Int

  status CodingTestStatus

  takenAt DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}

model Report {
  id Int @id @default(autoincrement())

  recommendation Recommendation

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}
