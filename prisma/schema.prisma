  NOT_FIT
}

enum NotificationType {
  INTERVIEWER_REQUIREMENT_READY
  INTERVIEWER_DATABASE_READY
  CLIENT_SHORTLIST_READY
  INTERVIEWER_INTERVIEW_BOOKED
}

enum PortalRole {
  ADMIN
  CLIENT
  INTERVIEWER
}

/// Company seat inside the client portal.
/// OWNER runs the account. MEMBER is general hiring access.
/// HR_HEAD collects basic requirements. RECRUITER analyses, posts, and collects candidates.
enum OrganizationMemberRole {
  OWNER
  MEMBER
  HR_HEAD
  RECRUITER
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

/// Internal billing foundation states only.
/// Payment processing is NOT implemented.
enum BillingStatus {
  PENDING
  READY
  INVOICED
  PAID
  CANCELLED
}

/// T90 identity signal kinds. Not matching/ranking scores.
enum CandidateIdentitySignalKind {
  EMAIL
  PHONE
  PROVIDER_CANDIDATE_ID
  LINKEDIN_URL
}

/// T90 append-only identity decision. UNLINK is recorded as NO_LINK.
enum CandidateIdentityDecisionType {
  LINK
  NO_LINK
  NEEDS_REVIEW
}

/// T91/T95 evidence artifact source.
/// HOSTED_APPLY_SUBMISSION = T91 hosted-apply cover letter.
/// INGESTION_EVENT = reserved for genuine ingestion evidence text (none in V1).
/// RECRUITER_ENTERED_TEXT = T95 Admin-attached application text.
enum CandidateEvidenceSourceType {
  HOSTED_APPLY_SUBMISSION
  INGESTION_EVENT
  RECRUITER_ENTERED_TEXT
  RESUME_DOCUMENT
}

/// T91 who supplied the captured artifact. Not verification or ranking.
enum CandidateEvidenceOrigin {
  CANDIDATE_PROVIDED
  PROVIDER_PROVIDED
  RECRUITER_ENTERED
  SYSTEM_RECORDED
}

/// T92 run lifecycle. V1 is synchronous Admin execution. No PENDING.
enum CandidateIntelligenceRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// T92 V1 extractor. Cover-letter / inlineText claims only.
enum CandidateIntelligenceExtractorType {
  COVER_LETTER_CLAIMS
  DETERMINISTIC_TEXT_V1
}

/// T92 V1 claim types. Education, certification, periods, years, and summaries are deferred.
enum CandidateClaimType {
  SKILL
  EMPLOYER
  JOB_TITLE
  LOCATION
}

/// T93 synchronous Admin matching. No PENDING. No ranking.
enum CandidateMatchRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// T93 V1 never emits NOT_SATISFIED. Missing skills are UNKNOWN.
enum CandidateMatchResult {
  SATISFIED
  UNKNOWN
  UNSUPPORTED
}

/// T93 requirement category. Must/nice blobs are UNSUPPORTED in V1.
enum CandidateMatchRequirementCategory {
  SKILL
  LOCATION
  MUST_HAVE
  NICE_TO_HAVE
}

/// Job Intelligence V1 run status. Not matching or ranking.
enum JobIntelligenceRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Deterministic published-spec extractor. OpenAI is not required.
enum JobIntelligenceExtractorType {
  DETERMINISTIC_SPEC_V1
}

/// Requirement Graph V1 node category. Ambiguous is not a hard requirement.
enum JobRequirementCategory {
  HARD_CONSTRAINT
  REQUIRED
  PREFERRED
  RESPONSIBILITY
  CONSTRAINT
  AMBIGUOUS
}

enum JobRequirementUncertainty {
  CERTAIN
  AMBIGUOUS
}

/// V1 ontology relationship. ALIAS only — related skills are not equivalent.
enum SkillAliasRelationshipType {
  ALIAS
}

/// Claim polarity. Existing T92 rows default to POSITIVE.
enum CandidateClaimPolarity {
  POSITIVE
  NEGATED
  UNCERTAIN
}

/// Matcher V2 support states. Do not reuse or rename CandidateMatchResult.
enum RequirementSupportState {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNKNOWN
  CONTRADICTED
  UNSUPPORTED
}

enum RequirementAssessmentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// M8 lexical retrieval run. Not matching, ranking, or a hire decision.
enum LexicalRetrievalRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// M9 semantic retrieval run. Independent of M8. Not matching or ranking.
enum SemanticRetrievalRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum RetrievalEmbeddingSourceType {
  JOB_QUERY
  EVIDENCE
}

/// Phase 5 evidence graph snapshot. Not ranking, retrieval, or candidate quality.
enum EvidenceGraphRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// M10 hybrid retrieval run. Rank fusion only. Not a hire score.
enum HybridRetrievalRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// M12 explicit human relevance. Not a pipeline status or a hire score.
enum HumanRelevanceLabel {
  RELEVANT
  NOT_RELEVANT
}

/// One human answer. A correction is a new row. The older row points at it.
model HumanRelevanceJudgment {
  id                        Int                  @id @default(autoincrement())
  companyId                 Int
  jobId                     Int
  applicationId             Int
  candidateId               Int
  jobSpecificationVersionId Int
  reviewerUserId            Int
  protocolVersion           String
  label                     HumanRelevanceLabel
  idempotencyKey            String               @unique
  supersededById            Int?
  createdAt                 DateTime             @default(now())

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                     Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  application             Application             @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate               Candidate               @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  reviewer                User                    @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)
  supersededBy            HumanRelevanceJudgment? @relation("HumanRelevanceSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes              HumanRelevanceJudgment[] @relation("HumanRelevanceSupersession")
  evidenceRefs            HumanRelevanceJudgmentEvidence[]

  @@unique([id, companyId])
  @@index([companyId, applicationId, createdAt])
  @@index([companyId, jobId, createdAt])
  @@index([supersededById])
}

/// Evidence ids the reviewer saw. Hash only; not a copy of the text.
model HumanRelevanceJudgmentEvidence {
  id           Int      @id @default(autoincrement())
  companyId    Int
  judgmentId   Int
  evidenceId   Int
  contentSha256 String?
  createdAt    DateTime @default(now())

  company  Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  judgment HumanRelevanceJudgment @relation(fields: [judgmentId, companyId], references: [id, companyId], onDelete: Restrict)
  evidence CandidateEvidence      @relation(fields: [evidenceId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, judgmentId])
  @@index([companyId, evidenceId])
}

enum OutcomeEventType {
  SHORTLISTED
  SELECTED
  HIRED
  REJECTED
  OFFER_ACCEPTED
  OFFER_DECLINED
}

enum OutcomeEventActorType {
  ADMIN
  CLIENT
  INTERVIEWER
  PUBLIC_TOKEN
}

/// Append-only hiring-process events. No backfill. No sensitive payload.
model OutcomeEvent {
  id              Int                    @id @default(autoincrement())
  companyId       Int
  jobId           Int
  applicationId   Int
  eventType       OutcomeEventType
  occurredAt      DateTime
  actorUserId     Int?
  actorType       OutcomeEventActorType
  fromStatus      ApplicationPipelineStatus?
  toStatus        ApplicationPipelineStatus?
  protocolVersion String

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job          @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  application Application  @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, applicationId, occurredAt])
  @@index([companyId, jobId, occurredAt])
}

/// Append-only operational audit. Not an OutcomeEvent and not editable.
model AuditLog {
  id          Int      @id @default(autoincrement())
  occurredAt  DateTime @default(now())
  /// Null only for actors that are not users. A CANDIDATE row must be null (database CHECK); the candidate is found through the target.
  actorUserId Int?
  actorRole   String
  companyId   Int
  action      String
  targetType  String
  targetId    Int
  reason      String?
  /// Which company-scoped SCIM credential acted. Set exactly when actorRole is SCIM (database CHECKs). The row's id only: never the token or its hash.
  scimTokenId Int?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor     User?      @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  scimToken ScimToken? @relation(fields: [scimTokenId], references: [id], onDelete: Restrict)

  @@index([companyId, occurredAt])
  @@index([actorUserId])
  @@index([scimTokenId])
}

/// Candidate-facing email outcome. Does not store the address or message.
enum EmailDeliveryOutcome {
  SENT
  PROVIDER_NOT_CONFIGURED
  MISSING_RECIPIENT
  PROVIDER_ERROR
}

enum EvidenceGraphNodeType {
  EVIDENCE
  CLAIM
  REQUIREMENT
  SKILL
  ASSESSMENT
}

/// Derived projection of existing FKs. Does not invent facts.
enum EvidenceGraphEdgeType {
  EVIDENCE_SUPPORTS_CLAIM
  CLAIM_MAPS_TO_SKILL
  REQUIREMENT_REQUIRES_SKILL
  CLAIM_CITED_FOR_REQUIREMENT
  ASSESSMENT_CITES_EVIDENCE
  ASSESSMENT_CITES_CLAIM
}

/// T94 synchronous Admin evidence-coverage ranking. No PENDING. No quality score.
enum JobRankingRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// T94 coverage status. Unranked applications are not assigned rank 0.
enum JobRankingCoverageStatus {
  RANKED
  UNRANKED_NO_MATCH
}

model Company {
  id         Int    @id @default(autoincrement())
  name       String
  industry   String
  employees  Int
  /// Public careers hub path: /careers/{publicSlug}. Stable after create; not a rename of the company.
  publicSlug String @unique
  /// When true, the public careers hub may show application counts. Off by default.
  publishApplicationCount Boolean @default(false)
  /// When true, active Client Members may confirm hire. Owners always can. Off by default.
  membersCanConfirmHire Boolean @default(false)
  /// Apply-form AI notice shown before submit. Null until a company writes one.
  applyNoticeText String?
  brandTone       String?
  brandBenefits   String?
  eeoBoilerplate  String?
  /// Evidence matching stays off until a company opts in. Never a hire score.
  evidenceMatchingEnabled Boolean @default(false)
  /// When true, only an interviewer with a qualified training record can be the lead.
  requireQualifiedLead Boolean @default(false)
  /// Public /feeds/{slug}/jobs.xml. Off until an admin enables it.
  jobsFeedEnabled Boolean @default(false)
  /// Public /feeds/{slug}/linkedin.xml. Off until company ID and poster email are saved.
  linkedInFeedEnabled Boolean @default(false)
  /// LinkedIn organization ID supplied by the employer. Not a posting ID.
  linkedInCompanyId String?
  /// LinkedIn poster email supplied by the employer. Required before the LinkedIn feed can be enabled.
  linkedInPosterEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates            Candidate[]
  /// T132 workspace-default agency markup in basis points (1000 = 10%). Null = billing math disabled.
  agencyMarkupBps Int?

  jobs                  Job[]
  users                 User[]
  billingRecords        BillingRecord[]
  notifications         Notification[]
  organizationMembers   OrganizationMember[]
  invitations           Invitation[]
  providerConnections   ProviderConnection[]
  jobDistributions      JobDistribution[]
  hostedApplySubmissions HostedApplySubmission[]
  ingestionEvents        ApplicationIngestionEvent[]
  companyPersons         CompanyPerson[]
  identityMemberships    CandidateIdentityMembership[]
  identitySignals        CandidateIdentitySignal[]
  identityDecisions      CandidateIdentityDecision[]
  candidateEvidence      CandidateEvidence[]
  candidateIntelligenceRuns CandidateIntelligenceRun[]
  candidateClaims           CandidateClaim[]
  candidateMatchRuns        CandidateMatchRun[]
  requirementMatches        RequirementMatch[]
  jobRankingRuns            JobRankingRun[]
  jobRankingResults         JobRankingResult[]
  jobIntelligenceRuns       JobIntelligenceRun[]
  jobRequirements           JobRequirement[]
  requirementAssessmentRuns RequirementAssessmentRun[]
  requirementAssessments    RequirementAssessment[]
  lexicalRetrievalRuns      LexicalRetrievalRun[]
  lexicalRetrievalResults   LexicalRetrievalResult[]
  semanticRetrievalRuns     SemanticRetrievalRun[]
  semanticRetrievalResults  SemanticRetrievalResult[]
  hybridRetrievalRuns       HybridRetrievalRun[]
  hybridRetrievalResults    HybridRetrievalResult[]
  humanRelevanceJudgments   HumanRelevanceJudgment[]
  humanRelevanceJudgmentEvidence HumanRelevanceJudgmentEvidence[]
  outcomeEvents             OutcomeEvent[]
  auditLogs                 AuditLog[]
  retrievalEmbeddings       RetrievalEmbedding[]
  evidenceGraphRuns         EvidenceGraphRun[]
  evidenceGraphEdges        EvidenceGraphEdge[]
  resumeDocuments CandidateResumeDocument[]
  apiTokens ApiToken[]
  webhookSubscriptions PartnerWebhookSubscription[]
  aiRuns                    AIRun[]
  featureFlags              CompanyFeatureFlag[]
  jdLintDismissals          JdLintDismissal[]
  workflowRules             WorkflowRule[]
  workflowExecutions        WorkflowExecution[]
  retentionPolicy           RetentionPolicy?
  jobTemplates              JobTemplate[]
  pipelineStageTemplates    PipelineStageTemplate[]
  decisionRecords           DecisionRecord[]
  knockoutQuestions         KnockoutQuestion[]
  generatedAssessments      GeneratedAssessment[]
  rediscoveryRejectDays     Int      @default(90)
  portalIdentities          CandidatePortalIdentity[]
  talentRediscoveryRuns     TalentRediscoveryRun[]
  talentRediscoveryActions  TalentRediscoveryAction[]
  talentRediscoveryInvites  TalentRediscoveryInvite[]
  portalDocuments           CandidatePortalDocument[]
  deletionRequests          CandidateDeletionRequest[]
  fairnessSnapshots         FairnessSnapshot[]
  fairnessReviews           FairnessReview[]
  copilotMessages           CopilotMessage[]
  ssoConnections            CompanySsoConnection[]
  whatsAppOptIns            WhatsAppOptIn[]
  scimUsers                 ScimDirectoryUser[]
  scimGroups                ScimDirectoryGroup[]
  scimTokens                ScimToken[]
  idpGroupRoles             IdpGroupRole[]
  notetakerConsents         NotetakerConsent[]
  notetakerNotes            NotetakerNote[]
  assessmentAiExchanges     AssessmentAiExchange[]
  hrisHandoffs              HrisHandoff[]
  outreachSequences         OutreachSequence[]
  profileCaptures           ProfileCapture[]
  offerEsigns               OfferEsign[]
  interviewerTraining       InterviewerTraining[]
  shadowObservations        ShadowObservation[]
  screeningPolicies         JobScreeningPolicy[]
  practicalCriterionScores  PracticalCriterionScore[]
  stageReminders            StageReminder[]
  closeOutBatches           CloseOutBatch[]
  spotChecks                SpotCheck[]
  indexingNotifications     IndexingNotification[]
  applicantImportBatches    ApplicantImportBatch[]
  applicantImportTemplates  ApplicantImportTemplate[]
  inboundEmailRoutes        InboundEmailRoute[]
  inboundEmailMessages      InboundEmailMessage[]
}

model Job {
  id     Int       @id @default(autoincrement())
  title  String
  status JobStatus @default(OPEN)

  roleCategory        RoleCategory?
  experienceRange     String?
  location            String?
  compensationRange   String?
  targetHireDate      DateTime?
  numberOfPositions   Int?
  mustHaveRequirements String?
  niceToHaveRequirements String?
  jobDescription      String?
  evaluationCriteria  String?
  primarySkills       String?

  requirementLifecycle RequirementLifecycle @default(REQUIREMENT_POSTED)
  clientCompletedAt    DateTime?

  sourcingDatabaseSource SourcingDatabaseSource?
  sourcingAccessDetails  String?

  sourcingAccessReceivedAt DateTime?
  shortlistingDueAt        DateTime?
  shortlistingCompletedAt  DateTime?

  /// Ordered interview types for this requirement. Empty = default phone screen, then technical.
  interviewRoundPlan InterviewType[] @default([])

  level        String?
  team         String?
  scopeText    String?
  outcomesText String?
  payBand      String?
  remotePolicy String?
  /// Per-job evidence opt-in. Hidden when the candidate opted out.
  evidenceMatchingEnabled Boolean @default(false)
  /// Names and photos stay off reviewer surfaces when true.
  blindReview Boolean @default(false)
  /// Human approval required before a job is treated as publish-approved (F17).
  publishApprovedAt   DateTime?
  publishApprovedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int
  /// Client submit token. Null for jobs created without a request key.
  clientCreateIdempotencyKey String?
  assignedInterviewerId Int?

  /// Compatibility projection of the published (or dual-written draft) spec.
  /// Canonical specification lives on JobSpecificationVersion.
  currentPublishedSpecificationVersionId Int? @unique

  company      Company        @relation(fields: [companyId], references: [id])
  assignedInterviewer Interviewer? @relation(fields: [assignedInterviewerId], references: [id], onDelete: Restrict)
  applications Application[]
  notifications Notification[]
  billingRecords BillingRecord[]
  specificationVersions JobSpecificationVersion[] @relation("JobSpecVersions")
  currentPublishedSpecificationVersion JobSpecificationVersion? @relation("JobPublishedSpec", fields: [currentPublishedSpecificationVersionId], references: [id], onDelete: SetNull)
  distributions JobDistribution[]
  hostedApplySubmissions HostedApplySubmission[]
  ingestionEvents ApplicationIngestionEvent[]
  matchRuns CandidateMatchRun[]
  rankingRuns JobRankingRun[]
  intelligenceRuns JobIntelligenceRun[]
  jobRequirements JobRequirement[]
  requirementAssessmentRuns RequirementAssessmentRun[]
  lexicalRetrievalRuns LexicalRetrievalRun[]
  semanticRetrievalRuns SemanticRetrievalRun[]
  hybridRetrievalRuns HybridRetrievalRun[]
  humanRelevanceJudgments HumanRelevanceJudgment[]
  outcomeEvents           OutcomeEvent[]
  evidenceGraphRuns     EvidenceGraphRun[]

  @@unique([id, companyId])
  @@unique([companyId, clientCreateIdempotencyKey])
  @@index([companyId, status])
  @@index([assignedInterviewerId])
  interviewSlots InterviewSlot[]
  generatedAssessments GeneratedAssessment[]
  talentRediscoveryRuns TalentRediscoveryRun[]
  talentRediscoveryActions TalentRediscoveryAction[]
  talentRediscoveryInvites TalentRediscoveryInvite[]
  screeningPolicies JobScreeningPolicy[]
  closeOutBatches   CloseOutBatch[]
  spotChecks        SpotCheck[]
  applicantImportBatches ApplicantImportBatch[]
  inboundEmailRoutes     InboundEmailRoute[]
  inboundEmailMessages   InboundEmailMessage[]
}

/// Versioned hiring specification. Job remains the operational root.
/// PUBLISHED rows are immutable. At most one DRAFT per Job (SQL partial unique).
model JobSpecificationVersion {
  id            Int                            @id @default(autoincrement())
  jobId         Int
  versionNumber Int
  status        JobSpecificationVersionStatus
  publishedAt   DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  createdByUserId Int?

  title                  String
  roleCategory           RoleCategory?
  experienceRange        String?
  location               String?
  compensationRange      String?
  targetHireDate         DateTime?
  numberOfPositions      Int?
  mustHaveRequirements   String?
  niceToHaveRequirements String?
  jobDescription         String?
  evaluationCriteria     String?
  primarySkills          String?
  structuredPayload      Json                    @default("{}")
  level                  String?
  team                   String?
  scopeText              String?
  outcomesText           String?
  payBand                String?
  remotePolicy           String?
  /// Frozen assessment bank IDs for this published version. Empty on DRAFT
  /// and on specs published before pinning existed (those mint from the live bank).
  assessmentQuestionIds  Int[]                   @default([])

  /// AI JD proposal only. Canonical jobDescription is unchanged until human accept.
  aiProposedJobDescription String?
  aiGeneratedAt            DateTime?
  aiGenerationStatus       JobDescriptionAiGenerationStatus @default(NONE)

  job       Job   @relation("JobSpecVersions", fields: [jobId], references: [id], onDelete: Restrict)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedForJob Job? @relation("JobPublishedSpec")
  distributions JobDistribution[]
  hostedApplySubmissions HostedApplySubmission[]
  ingestionEvents ApplicationIngestionEvent[]
  matchRuns CandidateMatchRun[]
  rankingRuns JobRankingRun[]
  intelligenceRuns JobIntelligenceRun[]
  jobRequirements JobRequirement[]
  requirementAssessmentRuns RequirementAssessmentRun[]
  lexicalRetrievalRuns LexicalRetrievalRun[]
  semanticRetrievalRuns SemanticRetrievalRun[]
  hybridRetrievalRuns HybridRetrievalRun[]
  humanRelevanceJudgments HumanRelevanceJudgment[]
  evidenceGraphRuns     EvidenceGraphRun[]

  @@unique([jobId, versionNumber])
  @@index([jobId, status])
  interviewBlueprint InterviewBlueprint?
}

/// Requirement-scoped billing foundation record.
/// No payment amounts, currency, or gateway fields.
model BillingRecord {
  id     Int           @id @default(autoincrement())
  status BillingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int
  jobId     Int

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  lineItems BillingLineItem[]

  @@index([companyId])
  @@index([jobId])
  @@index([status])
}

/// One billing line item per HIRED Application.
/// No fee/amount fields — pricing is not defined by product source.
model BillingLineItem {
  id Int @id @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingRecordId Int
  applicationId   Int

  /// T132 transparent markup snapshot. Null until compensation recorded.
  placedCtcCents         Int?
  markupBps              Int?
  feeCents               Int?
  compensationRecordedAt DateTime?

  billingRecord BillingRecord @relation(fields: [billingRecordId], references: [id], onDelete: Restrict)
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([applicationId])
  @@index([billingRecordId])
}

model Interviewer {
  id           Int                     @id @default(autoincrement())
  name         String
  category     InterviewerCategory
  availability InterviewerAvailability @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedJobs Job[]
  evaluations  Evaluation[]
  notifications Notification[]
  users         User[]
  invitations   InterviewerInvitation[]
  interviewSlots InterviewSlot[]
  profile        InterviewerProfile?
}

/// Descriptive interviewer card. Filled manually in the interviewer portal.
/// Not an evaluation score. Not a candidate profile.
model InterviewerProfile {
  id              Int     @id @default(autoincrement())
  interviewerId   Int     @unique
  headline        String?
  location        String?
  aboutText       String?
  roleTitle       String?
  experienceYears Int?
  domains         Json?
  linkedInUrl     String?
  githubUrl       String?
  portfolioUrl    String?
  twitterUrl      String?
  videoUrl        String?
  experiences     Json?
  education       Json?
  projects        Json?
  leetcodeUrl     String?
  /// Extra public social URLs not covered by canonical columns.
  socialLinks     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewer Interviewer @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
}

model Candidate {
  id              Int             @id @default(autoincrement())
  name            String
  role            String
  experienceYears Int
  status          CandidateStatus
  location        String?
  currentEmployer String?
  skills          String?
  expectedCTC     String?

  /// Set when we email this person once to ask about future roles.
  futureRolesAskedAt DateTime?

  /// Tombstone set by erasure. Pending work must refuse to write personal data for an erased candidate.
  erasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int

  company      Company        @relation(fields: [companyId], references: [id])
  erasures     CandidateErasure[]
  retentionHolds RetentionHold[]
  applications Application[]
  ingestionEvents ApplicationIngestionEvent[]
  profile      CandidateProfile?
  identityMembership CandidateIdentityMembership?
  identitySignals    CandidateIdentitySignal[]
  identityDecisionsLeft  CandidateIdentityDecision[] @relation("IdentityDecisionLeftCandidate")
  identityDecisionsRight CandidateIdentityDecision[] @relation("IdentityDecisionRightCandidate")
  evidence               CandidateEvidence[]
  intelligenceRuns       CandidateIntelligenceRun[]
  intelligenceClaims     CandidateClaim[]
  matchRuns              CandidateMatchRun[]
  rankingResults         JobRankingResult[]
  requirementAssessmentRuns RequirementAssessmentRun[]
  requirementAssessments    RequirementAssessment[]
  lexicalRetrievalResults   LexicalRetrievalResult[]
  semanticRetrievalResults  SemanticRetrievalResult[]
  hybridRetrievalResults    HybridRetrievalResult[]
  humanRelevanceJudgments   HumanRelevanceJudgment[]
  evidenceGraphRuns         EvidenceGraphRun[]

  @@unique([id, companyId])
  @@index([companyId])
  resumeDocuments CandidateResumeDocument[] @relation("CandidateResumeDocuments")
  portalIdentities CandidatePortalIdentity[]
  deletionRequests CandidateDeletionRequest[]
}

/// T89 deterministic descriptive profile. 1:1 with Candidate.
/// Not identity. Not evidence. Not matching/ranking.
/// Email/phone stay on ApplicationIngestionEvent / HostedApplySubmission.
model CandidateProfile {
  id              Int     @id @default(autoincrement())
  candidateId     Int     @unique
  companyId       Int
  headline        String?
  location        String?
  experienceYears Int?
  skillsText      String?
  currentEmployer String?
  expectedCTC     String?
  linkedInUrl     String?
  aboutText       String?
  roleTitle       String?
  domains         Json?
  githubUrl       String?
  portfolioUrl    String?
  twitterUrl      String?
  videoResumeUrl  String?
  experiences     Json?
  education       Json?
  projects        Json?
  /// Presentation photo. Not an identity signal.
  photoStorageKey   String?
  photoContentType  String?
  leetcodeUrl       String?
  /// Extra public social URLs not covered by canonical columns.
  socialLinks       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([candidateId, companyId])
  @@index([companyId])
}

/// T90 company-scoped logical person. Not a Candidate merge.
/// No email, phone, name, profile, or score fields.
model CompanyPerson {
  id        Int      @id @default(autoincrement())
  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships  CandidateIdentityMembership[]

  @@unique([id, companyId])
  @@index([companyId])
}

/// T90 membership: a Candidate belongs to at most one CompanyPerson.
model CandidateIdentityMembership {
  id              Int      @id @default(autoincrement())
  companyPersonId Int
  candidateId     Int
  companyId       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companyPerson CompanyPerson @relation(fields: [companyPersonId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate     Candidate     @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([candidateId])
  @@unique([candidateId, companyId])
  @@unique([companyPersonId, candidateId])
  @@index([companyId])
  @@index([companyPersonId])
}

/// T90 identity index. Provenance remains on ApplicationIngestionEvent.
/// normalizedValue follows existing ingestion plaintext-normalized storage.
model CandidateIdentitySignal {
  id                       Int                          @id @default(autoincrement())
  companyId                Int
  candidateId              Int
  kind                     CandidateIdentitySignalKind
  normalizedValue          String
  sourceChannel            ApplicationIngestionChannel?
  ingestionEventId         Int?
  hostedApplySubmissionId  Int?
  providerConnectionId     Int?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  company               Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  candidate             Candidate                    @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)
  ingestionEvent        ApplicationIngestionEvent?   @relation(fields: [ingestionEventId, companyId], references: [id, companyId], onDelete: Restrict)
  hostedApplySubmission HostedApplySubmission?       @relation(fields: [hostedApplySubmissionId, companyId], references: [id, companyId], onDelete: Restrict)
  providerConnection    ProviderConnection?          @relation(fields: [providerConnectionId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([companyId, candidateId, kind, normalizedValue])
  @@index([companyId, kind, normalizedValue])
  @@index([candidateId])
  @@index([ingestionEventId])
}

/// T90 append-only identity audit. Corrections insert a new row.
model CandidateIdentityDecision {
  id               Int                            @id @default(autoincrement())
  companyId        Int
  decision         CandidateIdentityDecisionType
  reasonCodes      String[]
  leftCandidateId  Int
  rightCandidateId Int
  actorUserId      Int?
  createdAt        DateTime                       @default(now())

  company        Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leftCandidate  Candidate  @relation("IdentityDecisionLeftCandidate", fields: [leftCandidateId, companyId], references: [id, companyId], onDelete: Restrict)
  rightCandidate Candidate  @relation("IdentityDecisionRightCandidate", fields: [rightCandidateId, companyId], references: [id, companyId], onDelete: Restrict)
  actorUser      User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([leftCandidateId])
  @@index([rightCandidateId])
}

/// T91 append-only evidence artifact. Not a claim, identity, or profile.
/// Cover letters snapshot HostedApplySubmission; no file/blob storage.

/// T97: resume file metadata. Binaries live in object storage (LOCAL driver
/// in dev), never in PostgreSQL. Text extraction is versioned and may be
/// re-run; parse failures retain the stored file for retry.
enum ResumeParseStatus {
  PENDING
  PARSING
  PARSED
  READY
  FAILED
}

model CandidateResumeDocument {
  id               Int               @id @default(autoincrement())
  companyId        Int
  candidateId      Int
  applicationId    Int?
  storageKey       String            @unique
  fileName         String
  contentType      String
  sizeBytes        Int
  contentSha256    String
  parseStatus      ResumeParseStatus @default(PENDING)
  extractedText    String?
  /// Model field suggestion. Empty when parsing failed or needs review.
  fieldSuggestion  Json?
  fieldsNeedReview Boolean           @default(false)
  extractorVersion String?
  parseErrorCode   String?
  ocrAttempts      Int               @default(0)
  ocrClaimedAt     DateTime?
  uploadedByUserId Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  candidate   Candidate         @relation("CandidateResumeDocuments", fields: [candidateId], references: [id], onDelete: Restrict)
  application Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  uploadedBy  User?             @relation("ResumeUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, contentSha256])
  @@index([companyId, candidateId])
}

/// Recruiter-entered text uniqueness is a SQL partial unique index on current
/// artifacts only (`revokedAt` and `supersededById` null).
model CandidateEvidence {
  id                      Int                         @id @default(autoincrement())
  companyId               Int
  candidateId             Int
  applicationId           Int?
  sourceType              CandidateEvidenceSourceType
  origin                  CandidateEvidenceOrigin
  ingestionEventId        Int?
  hostedApplySubmissionId Int?                        @unique
  actorUserId             Int?
  inlineText              String?
  contentSha256           String?
  supersededById          Int?
  revokedAt               DateTime?
  createdAt               DateTime                    @default(now())

  company               Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  candidate             Candidate                  @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  application           Application?               @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  ingestionEvent        ApplicationIngestionEvent? @relation(fields: [ingestionEventId, companyId], references: [id, companyId], onDelete: Restrict)
  hostedApplySubmission HostedApplySubmission?     @relation(fields: [hostedApplySubmissionId, companyId], references: [id, companyId], onDelete: Restrict)
  actorUser             User?                      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  supersededBy          CandidateEvidence?         @relation("EvidenceSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes            CandidateEvidence[]        @relation("EvidenceSupersession")
  intelligenceRuns      CandidateIntelligenceRun[]
  intelligenceClaims    CandidateClaim[]
  requirementMatches    RequirementMatch[]
  requirementAssessments RequirementAssessment[]
  semanticRetrievalResults SemanticRetrievalResult[]
  humanRelevanceJudgmentEvidence HumanRelevanceJudgmentEvidence[]

  @@unique([id, companyId])
  @@index([companyId, candidateId, createdAt])
  @@index([companyId, applicationId])
  @@index([supersededById])
}

/// T92 derived extraction run. Not profile, identity, evidence, matching, or ranking.
/// At most one COMPLETED row per extraction key (SQL partial unique).
model CandidateIntelligenceRun {
  id               Int                                @id @default(autoincrement())
  companyId        Int
  candidateId      Int
  evidenceId       Int
  status           CandidateIntelligenceRunStatus
  extractorType    CandidateIntelligenceExtractorType
  extractorVersion String
  modelProvider    String
  modelName        String
  promptVersion    String
  createdAt        DateTime                           @default(now())
  completedAt      DateTime?
  errorCode        String?
  durationMs       Int?

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  candidate Candidate         @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  evidence  CandidateEvidence @relation(fields: [evidenceId, companyId], references: [id, companyId], onDelete: Restrict)
  claims    CandidateClaim[]

  @@unique([id, companyId])
  @@index([companyId, candidateId, createdAt])
  @@index([companyId, evidenceId])
  @@index([status])
}

/// T92 derived claim. Always cites CandidateEvidence. Not verified truth.
model CandidateClaim {
  id               Int                @id @default(autoincrement())
  companyId        Int
  candidateId      Int
  runId            Int
  evidenceId       Int
  claimType        CandidateClaimType
  value            String
  normalizedValue  String?
  sourceSpanStart  Int?
  sourceSpanEnd    Int?
  polarity         CandidateClaimPolarity @default(POSITIVE)
  createdAt        DateTime           @default(now())

  company   Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  candidate Candidate                 @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  run       CandidateIntelligenceRun  @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Restrict)
  evidence  CandidateEvidence         @relation(fields: [evidenceId, companyId], references: [id, companyId], onDelete: Restrict)
  requirementMatches RequirementMatch[]
  requirementAssessments RequirementAssessment[]

  @@unique([id, companyId])
  @@index([companyId, candidateId, claimType])
  @@index([runId])
  @@index([evidenceId])
}

/// T93 Application ↔ published JobSpecificationVersion match run.
/// Not ranking. Not intelligence. Not identity. Snapshot hash is T92 run ids only.
model CandidateMatchRun {
  id                         Int                      @id @default(autoincrement())
  companyId                  Int
  applicationId              Int
  candidateId                Int
  jobId                      Int
  jobSpecificationVersionId  Int
  status                     CandidateMatchRunStatus
  matcherVersion             String
  requirementParseVersion    String
  aliasMapVersion            String
  intelligenceSnapshotHash   String
  createdAt                  DateTime                 @default(now())
  completedAt                DateTime?
  errorCode                  String?

  company                  Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application              Application             @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate                Candidate               @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  job                      Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion  JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  requirementMatches       RequirementMatch[]
  rankingResults           JobRankingResult[]

  @@unique([id, companyId])
  @@index([companyId, applicationId, createdAt])
  @@index([companyId, candidateId, createdAt])
  @@index([companyId, jobSpecificationVersionId, createdAt])
}

/// T93 requirement-level result. SATISFIED cites claim+evidence. No scores.
model RequirementMatch {
  id              Int                                @id @default(autoincrement())
  companyId       Int
  runId           Int
  requirementKey  String
  sourceField     String
  category        CandidateMatchRequirementCategory
  result          CandidateMatchResult
  reasonCode      String
  claimId         Int?
  evidenceId      Int?
  createdAt       DateTime                           @default(now())

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run      CandidateMatchRun  @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Restrict)
  claim    CandidateClaim?    @relation(fields: [claimId, companyId], references: [id, companyId], onDelete: Restrict)
  evidence CandidateEvidence? @relation(fields: [evidenceId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, runId])
  @@index([companyId, claimId])
  @@index([companyId, evidenceId])
}

/// T94 Job-scoped evidence-coverage ranking snapshot.
/// Not candidate quality. Not matching. Not intelligence. Pins one published spec.
model JobRankingRun {
  id                         Int                 @id @default(autoincrement())
  companyId                  Int
  jobId                      Int
  jobSpecificationVersionId  Int
  status                     JobRankingRunStatus
  rankingPolicyVersion       String
  matcherVersion             String
  requirementParseVersion    String
  aliasMapVersion            String
  applicationSetHash         String
  createdAt                  DateTime            @default(now())
  completedAt                DateTime?
  errorCode                  String?
  durationMs                 Int?
  rankedCount                Int                 @default(0)
  unrankedCount              Int                 @default(0)

  company                  Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                      Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion  JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  results                  JobRankingResult[]

  @@unique([id, companyId])
  @@index([companyId, jobId, createdAt])
  @@index([companyId, jobSpecificationVersionId, createdAt])
}

/// T94 per-application coverage result. Rank is cohort-relative. No scores.
model JobRankingResult {
  id                    Int                       @id @default(autoincrement())
  runId                 Int
  companyId             Int
  applicationId         Int
  candidateId           Int
  candidateMatchRunId   Int?
  rank                  Int?
  satisfiedSkillCount   Int?
  unknownSkillCount     Int?
  coverageStatus        JobRankingCoverageStatus
  createdAt             DateTime                  @default(now())

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run                JobRankingRun       @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Restrict)
  application        Application         @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate          Candidate           @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  candidateMatchRun  CandidateMatchRun?  @relation(fields: [candidateMatchRunId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, runId])
  @@index([companyId, applicationId])
  @@index([companyId, candidateId])
  @@index([companyId, candidateMatchRunId])
}

/// Global skill concept. Not tenant data. Not candidate evidence.
model SkillConcept {
  id              Int      @id @default(autoincrement())
  canonicalKey    String
  displayName     String
  ontologyVersion String
  provenance      String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  aliases      SkillAlias[]
  requirements JobRequirement[]

  @@unique([ontologyVersion, canonicalKey])
  @@index([active])
}

/// Versioned alias. ALIAS only — related technologies are not equivalent.
model SkillAlias {
  id               Int                         @id @default(autoincrement())
  conceptId        Int
  alias            String
  normalizedAlias  String
  relationshipType SkillAliasRelationshipType
  ontologyVersion  String
  provenance       String
  active           Boolean                     @default(true)
  createdAt        DateTime                    @default(now())

  concept SkillConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  @@unique([ontologyVersion, normalizedAlias])
  @@index([conceptId])
  @@index([active])
}

/// Deterministic Job Intelligence run pinned to a published specification.
model JobIntelligenceRun {
  id                        Int                         @id @default(autoincrement())
  companyId                 Int
  jobId                     Int
  jobSpecificationVersionId Int
  status                    JobIntelligenceRunStatus
  extractorType             JobIntelligenceExtractorType
  extractorVersion          String
  inputHash                 String
  createdAt                 DateTime                    @default(now())
  completedAt               DateTime?
  errorCode                 String?

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                     Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  requirements            JobRequirement[]
  assessmentRuns          RequirementAssessmentRun[]
  lexicalRetrievalRuns    LexicalRetrievalRun[]
  semanticRetrievalRuns   SemanticRetrievalRun[]
  @@unique([id, companyId])
  @@index([companyId, jobId, createdAt])
  @@index([companyId, jobSpecificationVersionId, createdAt])
}

/// Requirement Graph V1 node. Historically pinned to a specification version.
model JobRequirement {
  id                        Int                       @id @default(autoincrement())
  companyId                 Int
  runId                     Int
  jobId                     Int
  jobSpecificationVersionId Int
  stableKey                 String
  sourceField               String
  sourceText                String
  sourceSpanStart           Int?
  sourceSpanEnd             Int?
  category                  JobRequirementCategory
  normalizedValue           String?
  skillConceptId            Int?
  provenance                String
  uncertainty               JobRequirementUncertainty
  requirementType           RequirementOwnershipType  @default(REQUIRED)
  evidenceType              RequirementEvidenceType?
  weight                    Int                       @default(1)
  rationale                 String?
  origin                    RequirementOrigin         @default(AI)
  approvalStatus            RequirementApprovalStatus @default(DRAFT)
  approvedByUserId          Int?
  displayOrder              Int                       @default(0)
  createdAt                 DateTime                  @default(now())

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  approvedBy              User?                   @relation("RequirementApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  run                     JobIntelligenceRun      @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Restrict)
  job                     Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  skillConcept            SkillConcept?           @relation(fields: [skillConceptId], references: [id], onDelete: Restrict)
  assessments             RequirementAssessment[]
  blueprintQuestions      BlueprintQuestion[]

  @@unique([id, companyId])
  @@unique([runId, stableKey])
  @@index([companyId, jobSpecificationVersionId])
  @@index([companyId, runId])
  @@index([skillConceptId])
}

/// Matcher V2 run. Does not write Application.status. Does not reuse V1 enums.
model RequirementAssessmentRun {
  id                        Int                             @id @default(autoincrement())
  companyId                 Int
  applicationId             Int
  candidateId               Int
  jobId                     Int
  jobSpecificationVersionId Int
  jobIntelligenceRunId      Int
  status                    RequirementAssessmentRunStatus
  matcherVersion            String
  ontologyVersion           String
  intelligenceSnapshotHash  String
  createdAt                 DateTime                        @default(now())
  completedAt               DateTime?
  errorCode                 String?

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application             Application             @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate               Candidate               @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  job                     Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  jobIntelligenceRun      JobIntelligenceRun      @relation(fields: [jobIntelligenceRunId, companyId], references: [id, companyId], onDelete: Restrict)
  assessments             RequirementAssessment[]

  @@unique([id, companyId])
  @@index([companyId, applicationId, createdAt])
  @@index([companyId, jobSpecificationVersionId, createdAt])
}

/// Matcher V2 requirement-level result. Citations required for SUPPORTED/CONTRADICTED.
model RequirementAssessment {
  id               Int                     @id @default(autoincrement())
  companyId        Int
  runId            Int
  applicationId    Int
  candidateId      Int
  jobRequirementId Int
  supportState     RequirementSupportState
  method           String
  reasonCode       String
  claimId          Int?
  evidenceId       Int?
  /// Recruiter-facing status. MEETS is stored only when citationQuote is verbatim.
  reviewStatus       EvidenceReviewStatus @default(UNKNOWN)
  citationQuote      String?
  overrideReason     String?
  overriddenByUserId Int?
  createdAt        DateTime                @default(now())

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run            RequirementAssessmentRun @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Restrict)
  application    Application             @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate      Candidate               @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  jobRequirement JobRequirement          @relation(fields: [jobRequirementId, companyId], references: [id, companyId], onDelete: Restrict)
  claim          CandidateClaim?         @relation(fields: [claimId, companyId], references: [id, companyId], onDelete: Restrict)
  evidence       CandidateEvidence?      @relation(fields: [evidenceId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, runId])
  @@index([companyId, applicationId])
  @@index([companyId, jobRequirementId])
  @@index([companyId, claimId])
  @@index([companyId, evidenceId])
}

/// M8 lexical retrieval snapshot. Not matching, ranking, or candidate quality.
model LexicalRetrievalRun {
  id                        Int                       @id @default(autoincrement())
  companyId                 Int
  jobId                     Int
  jobSpecificationVersionId Int
  jobIntelligenceRunId      Int
  status                    LexicalRetrievalRunStatus
  retrievalVersion          String
  queryConstructionVersion  String
  normalizationVersion      String
  ontologyVersion           String
  resultLimit               Int
  searchedCount             Int                       @default(0)
  retrievedCount            Int                       @default(0)
  queryHash                 String
  evidenceSnapshotHash      String
  createdAt                 DateTime                  @default(now())
  completedAt               DateTime?
  errorCode                 String?

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                     Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  jobIntelligenceRun      JobIntelligenceRun      @relation(fields: [jobIntelligenceRunId, companyId], references: [id, companyId], onDelete: Restrict)
  results                 LexicalRetrievalResult[]
  hybridRuns              HybridRetrievalRun[] @relation("HybridLexicalBaseline")

  @@unique([id, companyId])
  @@index([companyId, jobId, createdAt])
  @@index([companyId, jobSpecificationVersionId, createdAt])
}

/// Per-application lexical retrieval row. lexicalScore is term overlap, not quality.
model LexicalRetrievalResult {
  id             Int      @id @default(autoincrement())
  companyId      Int
  runId          Int
  applicationId  Int
  candidateId    Int
  rank           Int
  lexicalScore   Int
  matchedTerms   String[]
  method         String
  createdAt      DateTime @default(now())

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run         LexicalRetrievalRun @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Restrict)
  application Application         @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate   Candidate           @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, runId])
  @@index([companyId, applicationId])
  @@index([companyId, candidateId])
}

/// Versioned embedding. Not a claim, match, or candidate quality score.
model RetrievalEmbedding {
  id                    Int                          @id @default(autoincrement())
  companyId             Int
  sourceType            RetrievalEmbeddingSourceType
  sourceId              Int
  contentHash           String
  modelProvider         String
  modelName             String
  modelVersion          String
  dimensions            Int
  normalizationVersion  String
  vector                Json
  createdAt             DateTime                     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, sourceType, sourceId, modelProvider, modelName, modelVersion, normalizationVersion, contentHash])
  @@index([companyId, sourceType, sourceId])
}

/// M9 semantic retrieval snapshot. Independent of LexicalRetrievalRun.
model SemanticRetrievalRun {
  id                         Int                        @id @default(autoincrement())
  companyId                  Int
  jobId                      Int
  jobSpecificationVersionId  Int
  jobIntelligenceRunId       Int
  status                     SemanticRetrievalRunStatus
  retrievalVersion           String
  queryConstructionVersion   String
  representationVersion      String
  normalizationVersion       String
  ontologyVersion            String
  embeddingProvider          String
  embeddingModel             String
  embeddingModelVersion      String
  embeddingDimensions        Int
  resultLimit                Int
  searchedCount              Int                        @default(0)
  retrievedCount             Int                        @default(0)
  queryHash                  String
  evidenceSnapshotHash       String
  createdAt                  DateTime                   @default(now())
  completedAt                DateTime?
  errorCode                  String?

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                     Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  jobIntelligenceRun      JobIntelligenceRun      @relation(fields: [jobIntelligenceRunId, companyId], references: [id, companyId], onDelete: Restrict)
  results                 SemanticRetrievalResult[]
  hybridRuns              HybridRetrievalRun[] @relation("HybridSemanticBaseline")

  @@unique([id, companyId])
  @@index([companyId, jobId, createdAt])
  @@index([companyId, jobSpecificationVersionId, createdAt])
}

/// M10 rank fusion of one completed M8 run and one completed M9 run.
model HybridRetrievalRun {
  id                         Int                       @id @default(autoincrement())
  companyId                  Int
  jobId                      Int
  jobSpecificationVersionId  Int
  lexicalRunId               Int
  semanticRunId              Int
  status                     HybridRetrievalRunStatus
  fusionVersion              String
  rrfK                       Int
  resultLimit                Int
  datasetVersion             String
  lexicalRetrievalVersion    String
  semanticRetrievalVersion   String
  retrievedCount             Int                       @default(0)
  createdAt                  DateTime                  @default(now())
  completedAt                DateTime?
  errorCode                  String?

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                     Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  lexicalRun              LexicalRetrievalRun     @relation("HybridLexicalBaseline", fields: [lexicalRunId, companyId], references: [id, companyId], onDelete: Restrict)
  semanticRun             SemanticRetrievalRun    @relation("HybridSemanticBaseline", fields: [semanticRunId, companyId], references: [id, companyId], onDelete: Restrict)
  results                 HybridRetrievalResult[]

  @@unique([id, companyId])
  @@index([companyId, jobId, createdAt])
}

/// Per-application RRF row. rrfScore is rank fusion, not candidate quality.
model HybridRetrievalResult {
  id              Int      @id @default(autoincrement())
  companyId       Int
  runId           Int
  applicationId   Int
  candidateId     Int
  rank            Int
  rrfScore        Float
  lexicalRank     Int?
  semanticRank    Int?
  fusionVersion   String
  createdAt       DateTime @default(now())

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run         HybridRetrievalRun @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Restrict)
  application Application        @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate   Candidate          @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, runId])
  @@index([companyId, applicationId])
  @@index([companyId, candidateId])
}

/// Per-application semantic retrieval row. semanticScore is cosine similarity.
model SemanticRetrievalResult {
  id                    Int      @id @default(autoincrement())
  companyId             Int
  runId                 Int
  applicationId         Int
  candidateId           Int
  rank                  Int
  semanticScore         Float
  supportingEvidenceId  Int?
  method                String
  createdAt             DateTime @default(now())

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run         SemanticRetrievalRun @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Restrict)
  application Application          @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate   Candidate            @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  evidence    CandidateEvidence?   @relation(fields: [supportingEvidenceId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, runId])
  @@index([companyId, applicationId])
  @@index([companyId, candidateId])
  @@index([companyId, supportingEvidenceId])
}

/// Phase 5 derived evidence-graph snapshot. Not a rank or candidate quality score.
model EvidenceGraphRun {
  id                        Int                    @id @default(autoincrement())
  companyId                 Int
  jobId                     Int
  applicationId             Int
  candidateId               Int
  jobSpecificationVersionId Int
  jobIntelligenceRunId      Int?
  matcherV2RunId            Int?
  status                    EvidenceGraphRunStatus
  graphVersion              String
  ontologyVersion           String
  matcherVersion            String?
  sourceSnapshotHash        String
  createdAt                 DateTime               @default(now())
  completedAt               DateTime?
  errorCode                 String?

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                     Job                      @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  application             Application              @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)
  candidate               Candidate                @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  jobSpecificationVersion JobSpecificationVersion  @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  edges                   EvidenceGraphEdge[]

  @@unique([id, companyId])
  @@index([companyId, applicationId, createdAt])
  @@index([companyId, jobId, createdAt])
}

/// Immutable historical edge. Validity of evidence is interpreted at read time.
model EvidenceGraphEdge {
  id                        Int                   @id @default(autoincrement())
  companyId                 Int
  runId                     Int
  edgeType                  EvidenceGraphEdgeType
  fromType                  EvidenceGraphNodeType
  fromId                    Int
  toType                    EvidenceGraphNodeType
  toId                      Int
  provenance                String
  sourceEvidenceId          Int?
  sourceClaimId             Int?
  sourceRequirementId       Int?
  sourceAssessmentId        Int?
  ontologyVersion           String?
  jobSpecificationVersionId Int?
  createdAt                 DateTime              @default(now())

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run     EvidenceGraphRun @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([companyId, runId, edgeType, fromType, fromId, toType, toId])
  @@index([companyId, runId])
  @@index([companyId, fromType, fromId])
  @@index([companyId, toType, toId])
}

model Application {
  id Int @id @default(autoincrement())

  status ApplicationPipelineStatus @default(CV_POOL)
  source SourcingDatabaseSource?
  expertScore Int?
  rejectionReason String?
  rejectionReasonCode String?
  /** Set when an application-form must-have answer did not match. A recruiter decides what happens next. */
  knockoutFailedAt DateTime?
  /// Fail-closed mirror of (aiPreference <> ALLOWED), kept by a database trigger. Do not treat false as consent.
  aiEvaluationOptOut Boolean @default(false)
  aiOptOutAt DateTime?
  /// What was explicitly stated. UNKNOWN never permits AI processing.
  aiPreference AiPreference @default(UNKNOWN)
  aiPreferenceSource String?
  aiPreferenceAt DateTime?
  consentAt DateTime?
  applyNoticeVersion String?
  humanReviewRequestedAt DateTime?

  /// First time this application reached SHORTLISTED. Null until that transition.
  shortlistedAt DateTime?

  /// Latest candidate stage-change email. Null when no candidate email was attempted.
  candidateStageEmailStatus EmailDeliveryOutcome?

  /// T133 offer pack: hashed token, terms, and candidate decision timestamps.
  offerAcceptanceTokenHash String? @unique
  offerMintedAt            DateTime?
  offerAcceptedAt          DateTime?
  offerDeclinedAt          DateTime?
  offerTerms               String?
  offerCompensation        String?
  proposedStartDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateId Int
  jobId       Int
  /// Denormalized tenant key enforcing Candidate.companyId === Job.companyId
  /// via composite foreign keys (database defense-in-depth).
  companyId   Int
  statusTokenHash String? @unique
  withdrawnAt DateTime?
  withdrawReason String?
  emailUnsubscribedAt DateTime?
  candidateTimeZone String?
  futureRolesConsent Boolean @default(false)
  whatsAppOptInAt DateTime?

  candidate Candidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  job       Job       @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  interviews Interview[]
  codingTests CodingTest[]
  reports     Report[]
  evaluations Evaluation[]
  billingLineItem BillingLineItem?
  ingestionEvents ApplicationIngestionEvent[]
  evidence        CandidateEvidence[]
  matchRuns       CandidateMatchRun[]
  rankingResults  JobRankingResult[]
  requirementAssessmentRuns RequirementAssessmentRun[]
  requirementAssessments    RequirementAssessment[]
  lexicalRetrievalResults   LexicalRetrievalResult[]
  semanticRetrievalResults  SemanticRetrievalResult[]
  hybridRetrievalResults    HybridRetrievalResult[]
  humanRelevanceJudgments   HumanRelevanceJudgment[]
  outcomeEvents             OutcomeEvent[]
  evidenceGraphRuns         EvidenceGraphRun[]
  assessmentInvite AssessmentInvite?

  @@unique([id, companyId])
  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId, status])
  @@index([companyId])
  resumeDocuments CandidateResumeDocument[]
  bookingInvite InterviewBookingInvite?
  portalDocuments CandidatePortalDocument[]
  deletionRequests CandidateDeletionRequest[]
  stageReminders StageReminder[]
  spotChecks     SpotCheck[]
}

model Evaluation {
  id Int @id @default(autoincrement())

  overallScore    Int?
  scorecard       Json?
  notes           String?
  recordingUrl    String?
  recommendation  Recommendation?
  hireProbability String?
  fitDecision     EvaluationFitDecision?
  evaluatedAt     DateTime?
  /// Null until this interviewer submits. Other scorecards stay hidden until then.
  submittedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId Int
  interviewerId Int

  application Application @relation(fields: [applicationId], references: [id])
  interviewer Interviewer @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  questions   EvaluationQuestion[]

  @@unique([applicationId, interviewerId])
  @@index([applicationId])
  @@index([interviewerId])
  competencyScores EvaluationCompetencyScore[] @relation("EvaluationCompetencyScores")
}

model EvaluationQuestion {
  id Int @id @default(autoincrement())

  question      String
  answer        String?
  expertComment String?
  score         Int?
  difficulty    String?
  weight        String?
  jobRequirementId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluationId Int

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  @@index([evaluationId])
}

model Interview {
  id          Int             @id @default(autoincrement())
  type        InterviewType
  interviewAt DateTime
  result      InterviewResult
  /// Booking confirmation email. Null when delivery was not attempted.
  bookingEmailStatus EmailDeliveryOutcome?
  /// Google Calendar event this app created. Null when Calendar is not connected.
  calendarEventId String?
  meetUrl         String?
  noShow          Boolean @default(false)
  reminders       InterviewReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}

/// Email reminders for an interview this app booked. A cron sends rows whose sendAt has passed.
model InterviewReminder {
  id           Int       @id @default(autoincrement())
  interviewId  Int
  kind         String
  sendAt       DateTime
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, kind])
  @@index([sentAt, sendAt])
}

model CodingTest {
  id Int @id @default(autoincrement())

  title String

  /// Meaningful only when status is COMPLETED. Practical assignments keep 0 until gradedAt is set.
  score Int

  maxScore Int

  status CodingTestStatus

  takenAt DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  applicationId Int

  /// Practical work sample fields. Null on interviewer-recorded tests.
  instructions      String?
  allowedResources  String?
  estimatedMinutes  Int?
  compensationNote  String?
  assignedAt        DateTime?
  dueAt             DateTime?
  /// SHA-256 of the candidate link. The raw token is never stored.
  inviteTokenHash   String?   @unique
  submittedAt       DateTime?
  submissionText    String?
  submissionUrl     String?
  /// Set once every rubric criterion has a human score.
  gradedAt          DateTime?
  /// Rubric snapshot this assignment is graded against.
  screeningPolicyId Int?

  application     Application               @relation(fields: [applicationId], references: [id])
  screeningPolicy JobScreeningPolicy?       @relation(fields: [screeningPolicyId], references: [id], onDelete: Restrict)
  criterionScores PracticalCriterionScore[]
  @@index([applicationId])
  @@index([screeningPolicyId])
}

/// Versioned screening configuration for one job. Rows are append-only and the
/// highest version is current. Weights are recruiter-set, not empirically validated.
model JobScreeningPolicy {
  id                        Int      @id @default(autoincrement())
  companyId                 Int
  jobId                     Int
  version                   Int
  basicWeight               Int
  practicalWeight           Int
  evidenceWeight            Int
  /// Null means no qualification threshold for that component.
  basicPassPercent          Int?
  practicalPassPercent      Int?
  borderlineBandPercent     Int      @default(5)
  /// How many candidates the recruiter can review first. Not a qualification standard.
  reviewCapacity            Int      @default(25)
  practicalTitle            String?
  practicalInstructions     String?
  practicalEstimatedMinutes Int?
  practicalAllowedResources String?
  practicalDeadlineDays     Int      @default(5)
  practicalCompensationNote String?
  practicalRubric           Json     @default("[]")
  createdByUserId           Int
  createdAt                 DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job          @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy   User         @relation("ScreeningPolicyAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  codingTests CodingTest[]

  @@unique([jobId, version])
  @@index([companyId, jobId])
}

enum PracticalScoreSource {
  HUMAN
  AI_SUGGESTED
}

/// Append-only criterion score. A correction is a new row; the latest HUMAN row per criterion counts.
model PracticalCriterionScore {
  id             Int                  @id @default(autoincrement())
  companyId      Int
  codingTestId   Int
  criterionKey   String
  points         Int
  maxPoints      Int
  source         PracticalScoreSource
  rationale      String?
  evidenceQuote  String?
  gradedByUserId Int?
  createdAt      DateTime             @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  codingTest CodingTest @relation(fields: [codingTestId], references: [id], onDelete: Restrict)
  gradedBy   User?      @relation("PracticalScoreGrader", fields: [gradedByUserId], references: [id], onDelete: Restrict)

  @@index([codingTestId, criterionKey, createdAt])
  @@index([companyId])
}

/// One deadline reminder per open assessment or assignment. The unique key stops duplicates.
/// A recruiter-proposed bulk close-out. Nothing changes until a human approves it.
model CloseOutBatch {
  id               Int       @id @default(autoincrement())
  companyId        Int
  jobId            Int
  category         String
  reason           String
  applicationIds   Json
  proposedByUserId Int
  proposedAt       DateTime  @default(now())
  approvedByUserId Int?
  approvedAt       DateTime?
  cancelledAt      DateTime?
  result           Json?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job     Job     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, jobId, proposedAt])
}

/// A weekly random human check of candidates the screening placed below the cutoff.
model SpotCheck {
  id               Int       @id @default(autoincrement())
  companyId        Int
  jobId            Int
  applicationId    Int
  weekStart        DateTime
  sourceCategory   String
  reviewedByUserId Int?
  reviewedAt       DateTime?
  outcome          String?
  note             String?
  createdAt        DateTime  @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job         @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  application Application @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([jobId, weekStart, applicationId])
  @@index([companyId, jobId, weekStart])
}

model StageReminder {
  id            Int       @id @default(autoincrement())
  companyId     Int
  applicationId Int
  targetType    String
  targetId      Int
  kind          String
  sentAt        DateTime  @default(now())
  outcome       String
  createdAt     DateTime  @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([targetType, targetId, kind])
  @@index([companyId, applicationId])
}

model Report {
  id Int @id @default(autoincrement())

  recommendation Recommendation

  notes String?

  version    Int     @default(1)
  bodyJson   Json    @default("{}")
  narrative  String?
  inputHash  String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}

model Notification {
  id Int @id @default(autoincrement())

  type NotificationType

  message String

  createdAt DateTime @default(now())
  /// Set only after a successful outbound email. Null means not delivered.
  emailDeliveredAt DateTime?

  jobId Int
  interviewerId Int?
  companyId Int

  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  interviewer Interviewer? @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([jobId, interviewerId, type])
  @@unique([jobId, companyId, type])
  @@index([jobId])
  @@index([interviewerId])
  @@index([companyId])
  @@index([type])
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String
  role         PortalRole
  /// bcrypt hash — never expose to clients
  passwordHash String
  /// Null until the mailbox is proven. Existing V1 users are backfilled.
  emailVerifiedAt DateTime?
  /// Set on password reset / invite completion. JWTs issued earlier are rejected.
  passwordChangedAt DateTime?
  /// Set when an admin deactivates a login. Null means the account may authenticate.
  disabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Compatibility projection of ACTIVE OrganizationMember.companyId.
  /// Not the Client authorization authority.
  companyId     Int?
  interviewerId Int? @unique

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interviewer Interviewer? @relation(fields: [interviewerId], references: [id], onDelete: Restrict)

  organizationMemberships OrganizationMember[]
  humanRelevanceJudgments HumanRelevanceJudgment[]
  outcomeEvents           OutcomeEvent[]
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  screeningPolicies       JobScreeningPolicy[]     @relation("ScreeningPolicyAuthor")
  practicalScores         PracticalCriterionScore[] @relation("PracticalScoreGrader")
  sentInvitations         Invitation[]             @relation("InvitationInviter")
  sentInterviewerInvitations InterviewerInvitation[] @relation("InterviewerInvitationInviter")
  invitedMembers          OrganizationMember[]     @relation("MembershipInviter")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  jobSpecificationVersions JobSpecificationVersion[]
  identityDecisions        CandidateIdentityDecision[]
  candidateEvidence        CandidateEvidence[]

  @@index([companyId])
  @@index([role])
  resumesUploaded CandidateResumeDocument[] @relation("ResumeUploadedBy")
  approvedRequirements JobRequirement[] @relation("RequirementApprover")
  decisionRecords DecisionRecord[] @relation("DecisionRecorder")
  calendarIntegrations InterviewerCalendarIntegration[] @relation("UserCalendarIntegration")
}

model OrganizationMember {
  id              Int                      @id @default(autoincrement())
  companyId       Int
  userId          Int
  role            OrganizationMemberRole
  status          OrganizationMemberStatus
  invitedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitedBy User?   @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId, status])
  @@index([companyId, status])
  @@index([companyId, role, status])
}

model Invitation {
  id              Int                    @id @default(autoincrement())
  companyId       Int
  email           String
  role            OrganizationMemberRole
  tokenHash       String                 @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invitedBy User    @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@index([expiresAt])
}

/// Admin-invited HireIQ interviewer login. Not a company Invitation.
model InterviewerInvitation {
  id              Int       @id @default(autoincrement())
  interviewerId   Int
  email           String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewer Interviewer @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  invitedBy   User        @relation("InterviewerInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([interviewerId])
  @@index([email])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model AuthRateLimit {
  id          Int      @id @default(autoincrement())
  key         String
  windowStart DateTime
  count       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
}

/// Company-owned provider credential. Secrets are AES-256-GCM ciphertext only.
/// T69 sourcingDatabaseSource is unrelated and must not be stored here.
model ProviderConnection {
  id                 Int                      @id @default(autoincrement())
  companyId          Int
  provider           DistributionProvider
  status             ProviderConnectionStatus @default(INACTIVE)
  providerAccountId  String?
  credentialCiphertext String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  distributions JobDistribution[]
  identitySignals CandidateIdentitySignal[]

  @@unique([id, companyId])
  @@unique([companyId, provider])
  @@index([companyId, status])
}

/// Intent to distribute a Job to one provider against a pinned PUBLISHED spec.
/// jobSpecificationVersionId is immutable after insert (application-enforced).
model JobDistribution {
  id                         Int                   @id @default(autoincrement())
  companyId                  Int
  jobId                      Int
  jobSpecificationVersionId  Int
  provider                   DistributionProvider
  providerConnectionId       Int?
  status                     JobDistributionStatus @default(READY)
  applyMode                  ApplyMode
  applyUrlSnapshot           String?
  includeCompensation        Boolean               @default(false)

  /// T131 programmatic bidding seam (Appcast-style). Null = organic only.
  dailyBudgetCents           Int?
  cpcBidCents                Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                  Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                      Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  pinnedSpecificationVersion JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  providerConnection       ProviderConnection?     @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  posting                  ProviderPosting?
  attempts                 DistributionAttempt[]
  applyTokens              ApplyToken[]
  hostedApplySubmissions   HostedApplySubmission[]
  ingestionEvents          ApplicationIngestionEvent[]

  @@index([companyId])
  @@index([jobId, provider])
  @@index([jobSpecificationVersionId])
  @@index([status])

  reconciliationRuns DistributionReconciliationRun[] @relation("DistributionReconciliationRuns")
  resumeUploads HostedApplyResumeUpload[]
  photoUploads  HostedApplyPhotoUpload[]
  indexingNotifications IndexingNotification[]
}

/// One Google Indexing API attempt for a public job URL.
/// SUBMITTED means Google accepted the notification, not that the URL is indexed.
model IndexingNotification {
  id                 Int                         @id @default(autoincrement())
  companyId          Int
  distributionId     Int
  publicUrl          String
  notificationType   IndexingNotificationType
  status             IndexingNotificationStatus  @default(PENDING)
  httpStatus         Int?
  errorCode          String?
  attemptCount       Int                         @default(0)
  nextAttemptAt      DateTime?
  submittedAt        DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  distribution JobDistribution @relation(fields: [distributionId], references: [id], onDelete: Restrict)

  @@unique([distributionId, notificationType])
  @@index([companyId, distributionId])
  @@index([status, nextAttemptAt])
}

/// External listing identity for one JobDistribution. No fabricated IDs.
model ProviderPosting {
  id                Int                   @id @default(autoincrement())
  distributionId    Int                   @unique
  provider          DistributionProvider
  externalPostingId String?
  externalUrl       String?
  providerStatus    ProviderPostingStatus @default(UNKNOWN)
  providerCreatedAt DateTime?
  providerUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distribution JobDistribution @relation(fields: [distributionId], references: [id], onDelete: Restrict)
  ingestionEvents ApplicationIngestionEvent[]

  @@index([provider, externalPostingId])
}

/// One persisted provider operation. History is never erased on retry.
model DistributionAttempt {
  id                 Int                           @id @default(autoincrement())
  distributionId     Int
  operation          DistributionAttemptOperation
  idempotencyKey     String                        @unique
  requestFingerprint String?
  status             DistributionAttemptStatus
  normalizedError    Json?
  sanitizedResponse  Json?
  startedAt          DateTime                      @default(now())
  completedAt        DateTime?

  createdAt DateTime @default(now())

  distribution JobDistribution @relation(fields: [distributionId], references: [id], onDelete: Restrict)

  @@index([distributionId, createdAt])
  @@index([status])
}

/// T84 opaque public apply token. SHA-256 at rest. No plaintext token column.
/// Resolves to one JobDistribution (and its pinned PUBLISHED specification).
model ApplyToken {
  id             Int       @id @default(autoincrement())
  distributionId Int
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  distribution JobDistribution         @relation(fields: [distributionId], references: [id], onDelete: Restrict)
  submissions  HostedApplySubmission[]

  @@index([distributionId])
}

/// T84 public apply handoff for T85. Not an Application. Not a hiring pipeline.
/// Unique (distributionId, emailNormalized) is T84 anti-duplicate only —
/// not Candidate identity. T85/T91 own identity resolution.
model HostedApplySubmission {
  id                        Int                          @id @default(autoincrement())
  applyTokenId              Int
  distributionId            Int
  companyId                 Int
  jobId                     Int
  jobSpecificationVersionId Int
  idempotencyKey            String                       @unique
  emailNormalized           String
  name                      String
  phone                     String?
  location                  String?
  experienceYears           Int?
  linkedInUrl               String?
  coverLetter               String?
  /// Structured career sections from the hosted apply form.
  /// Descriptive only. Email/phone stay on this row, not on CandidateProfile.
  profilePayload            Json?
  consentAcceptedAt         DateTime
  status                    HostedApplySubmissionStatus  @default(RECEIVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applyToken               ApplyToken              @relation(fields: [applyTokenId], references: [id], onDelete: Restrict)
  distribution             JobDistribution         @relation(fields: [distributionId], references: [id], onDelete: Restrict)
  company                  Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                      Job                     @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  pinnedSpecificationVersion JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  ingestionEvent           ApplicationIngestionEvent?
  identitySignals          CandidateIdentitySignal[]
  evidence                 CandidateEvidence[]

  @@unique([id, companyId])
  @@unique([distributionId, emailNormalized])
  @@index([applyTokenId])
  @@index([distributionId])
  @@index([jobId])
  @@index([createdAt])
}

/// T85 evidence that an application arrived through a channel.
/// Not an Application. Not a Candidate. Not a hiring-pipeline state.
model ApplicationIngestionEvent {
  id                        Int                          @id @default(autoincrement())
  companyId                 Int
  jobId                     Int
  applicationId             Int?
  candidateId               Int?
  sourceChannel             ApplicationIngestionChannel
  distributionId            Int?
  providerPostingId         Int?
  hostedApplySubmissionId   Int?                         @unique
  externalApplicationId     String?
  externalCandidateId       String?
  jobSpecificationVersionId Int
  status                    ApplicationIngestionStatus   @default(RECEIVED)
  applicantName             String
  applicantEmailNormalized  String?
  applicantPhone            String?
  applicantLocation         String?
  applicantExperienceYears  Int?
  applicantLinkedInUrl      String?
  errorCode                 String?
  errorMessage              String?
  receivedAt                DateTime                     @default(now())
  processedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                    Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                        Job                      @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  application                Application?             @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  candidate                  Candidate?               @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  distribution               JobDistribution?         @relation(fields: [distributionId], references: [id], onDelete: Restrict)
  providerPosting            ProviderPosting?         @relation(fields: [providerPostingId], references: [id], onDelete: Restrict)
  hostedApplySubmission      HostedApplySubmission?   @relation(fields: [hostedApplySubmissionId], references: [id], onDelete: Restrict)
  pinnedSpecificationVersion JobSpecificationVersion  @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  identitySignals            CandidateIdentitySignal[]
  evidence                   CandidateEvidence[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([jobId])
  @@index([status])
  @@index([sourceChannel])
  @@index([createdAt])
}

/// HireIQ-owned MCQ bank. Not tenant data. Not interviewer-authored.
enum GeneratedAssessmentStatus {
  DRAFT
  PUBLISHED
}

model GeneratedAssessment {
  id               Int                       @id @default(autoincrement())
  jobId            Int
  companyId        Int
  version          Int
  status           GeneratedAssessmentStatus @default(DRAFT)
  timeLimitMinutes Int                       @default(45)
  /// Items drawn per candidate from the pool.
  drawCount        Int                       @default(8)
  /// Allowed resources, accommodations, and support contact shown before the candidate starts.
  candidateInstructions String?
  items            Json
  publishedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invites GeneratedAssessmentInvite[]

  @@unique([jobId, version])
  @@index([jobId, status])
}

model GeneratedAssessmentInvite {
  id                 Int       @id @default(autoincrement())
  applicationId      Int
  assessmentId       Int
  tokenHash          String    @unique
  handoffTokenHash   String?   @unique
  itemOrder          Json
  answers            Json      @default("{}")
  integrity          Json?
  extraTimeRequested Boolean   @default(false)
  startedAt          DateTime?
  submittedAt        DateTime?
  expiresAt          DateTime
  grades             Json?
  /// Null after submit means grading did not finish.
  gradedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assessment GeneratedAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([expiresAt])
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model AssessmentBankQuestion {
  id           Int          @id @default(autoincrement())
  roleCategory RoleCategory
  sortOrder    Int
  prompt       String
  choices      Json
  correctIndex Int
  weight       Int          @default(1)
  skillTag     String?
  /// T134: adaptive selection tier. Default MEDIUM for seeded questions.
  difficulty   QuestionDifficulty @default(MEDIUM)
  /// T102: retired questions are excluded from future invites but kept
  /// for historical scoring reproducibility.
  active       Boolean      @default(true)
  /// Times this question was included in a minted invite (exposure count).
  timesUsed    Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers AssessmentAnswer[]

  @@unique([roleCategory, sortOrder])
  @@index([roleCategory])
}

/// Opaque public invite. SHA-256 at rest. One per Application.
model AssessmentInvite {
  id            Int      @id @default(autoincrement())
  applicationId Int      @unique
  tokenHash     String   @unique
  roleCategory  RoleCategory
  questionIds   Int[]
  scoringKey    Json
  expiresAt     DateTime
  startedAt     DateTime?
  submittedAt   DateTime?
  revokedAt     DateTime?
  /// AI_ALLOWED or NOT_ALLOWED. The assistant stays off unless a company sets AI_ALLOWED.
  aiUsePolicy   String   @default("NOT_ALLOWED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  attempt     AssessmentAttempt?

  @@index([expiresAt])
}

model AssessmentAttempt {
  id        Int                      @id @default(autoincrement())
  inviteId  Int                      @unique
  status    AssessmentAttemptStatus  @default(PENDING)
  score     Int                      @default(0)
  maxScore  Int
  startedAt DateTime?
  submittedAt DateTime?
  /// T101: client-self-reported focus/copy telemetry captured during the
  /// attempt. Honest labeling: these are signals, NOT proof of misconduct,
  /// and are never shown on public surfaces (§14/§40).
  integritySignals Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invite  AssessmentInvite   @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  answers AssessmentAnswer[]
}

model AssessmentAnswer {
  id            Int     @id @default(autoincrement())
  attemptId     Int
  questionId    Int
  selectedIndex Int
  isCorrect     Boolean
  weight        Int

  createdAt DateTime @default(now())

  attempt  AssessmentAttempt      @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question AssessmentBankQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

/// T96 Phase 2: durable ledger of every provider webhook delivery.
/// ACCEPTED  — signature valid, payload processed into ingestion.
/// QUARANTINED — signature valid but payload unprocessable; raw payload
///               preserved (size-capped) for admin triage and replay after fix.
/// REJECTED  — auth/config failure; metadata only, attacker-controlled
///             payloads are never persisted.
model ProviderWebhookDelivery {
  id              Int                            @id @default(autoincrement())
  provider        DistributionProvider
  externalEventId String?
  status          ProviderWebhookDeliveryStatus
  httpStatus      Int
  signatureValid  Boolean
  payloadRaw      String?
  payloadSha256   String?
  errorCode       String?
  errorMessage    String?
  receivedAt      DateTime                       @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([provider, status, receivedAt])
}

enum ProviderWebhookDeliveryStatus {
  ACCEPTED
  QUARANTINED
  REJECTED
}

/// T100 Phase 9: self-serve interview scheduling.
/// Admins (or assigned interviewers) publish OPEN slots for a job; the
/// candidate books one via a token-scoped public page. Booking creates the
/// Interview row transactionally — double-booking is impossible because
/// the slot row is claimed by a guarded update, not a check-then-write.
enum InterviewSlotStatus {
  OPEN
  BOOKED
  CANCELLED
}

model InterviewSlot {
  id              Int                 @id @default(autoincrement())
  jobId           Int
  interviewerId   Int
  interviewType   InterviewType
  startAt         DateTime
  durationMinutes Int                 @default(45)
  status          InterviewSlotStatus @default(OPEN)
  bookedApplicationId Int?

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  interviewer Interviewer @relation(fields: [interviewerId], references: [id], onDelete: Restrict)

  @@unique([interviewerId, startAt])
  @@index([jobId, status, startAt])
}

/// Token-scoped booking invite per application (hash stored only).
model InterviewBookingInvite {
  id            Int       @id @default(autoincrement())
  applicationId Int       @unique
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  /// When set, only open slots of exactly this length can be listed or booked with this link.
  requiredDurationMinutes Int?
  createdAt     DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
}

/// T104: resume uploaded during hosted apply BEFORE the candidate exists.
/// Promoted into CandidateResumeDocument (+ RESUME_DOCUMENT evidence) inside
/// the ingestion transaction once the application is created.
enum HostedResumeParseStatus {
  PARSING
  PARSED
  READY
  FAILED
}

model HostedApplyResumeUpload {
  id                       Int                      @id @default(autoincrement())
  distributionId           Int
  jobId                    Int
  companyId                Int
  applyTokenHash           String
  hostedApplySubmissionId  Int?                     @unique
  claimTokenHash           String                   @unique
  storageKey               String
  fileName                 String
  contentType              String
  sizeBytes                Int
  contentSha256            String
  parseStatus              HostedResumeParseStatus
  extractedText            String?
  fieldSuggestion          Json?
  fieldsNeedReview         Boolean                  @default(false)
  extractorVersion         String?
  parseErrorCode           String?
  ocrAttempts              Int                      @default(0)
  ocrClaimedAt             DateTime?
  expiresAt                DateTime
  claimedAt                DateTime?
  createdAt                DateTime                 @default(now())

  distribution JobDistribution @relation(fields: [distributionId], references: [id], onDelete: Restrict)

  @@index([distributionId, createdAt])
}

/// Pending profile photo for hosted apply. Claim-token pattern, same as resume.
/// Presentation only — not identity, not evidence.
model HostedApplyPhotoUpload {
  id                       Int      @id @default(autoincrement())
  distributionId           Int
  jobId                    Int
  companyId                Int
  applyTokenHash           String
  hostedApplySubmissionId  Int?     @unique
  claimTokenHash           String   @unique
  storageKey               String
  fileName                 String
  contentType              String
  sizeBytes                Int
  contentSha256            String
  expiresAt                DateTime
  claimedAt                DateTime?
  createdAt                DateTime @default(now())

  distribution JobDistribution @relation(fields: [distributionId], references: [id], onDelete: Restrict)

  @@index([distributionId, createdAt])
}

/// T112 Phase 12: public API keys. Hash-only persistence (same pattern as
/// ApplyToken); raw keys are shown exactly once at creation.
model ApiToken {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String
  tokenHash   String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
}

/// T98 Phase 7: structured interview kit. A rubric attached to a published
/// job specification version. Versioned + snapshot-based so later edits
/// never rewrite historical evaluation evidence.
model InterviewBlueprint {
  id                        Int      @id @default(autoincrement())
  jobSpecificationVersionId Int      @unique
  version                   Int      @default(1)
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  specification JobSpecificationVersion @relation(fields: [jobSpecificationVersionId], references: [id], onDelete: Restrict)
  competencies  BlueprintCompetency[]
  questions     BlueprintQuestion[]
}

model BlueprintCompetency {
  id          Int    @id @default(autoincrement())
  blueprintId Int
  name        String
  description String?
  weight      Int
  sortOrder   Int    @default(0)

  blueprint InterviewBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  questions BlueprintQuestion[]

  @@unique([blueprintId, name])
}

model BlueprintQuestion {
  id           Int     @id @default(autoincrement())
  blueprintId  Int
  competencyId Int
  question     String
  guidance     String?
  difficulty   String?
  active       Boolean @default(true)
  jobRequirementId Int?
  anchorLow    String?
  anchorMid    String?
  anchorHigh   String?

  blueprint  InterviewBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  competency BlueprintCompetency @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  jobRequirement JobRequirement? @relation(fields: [jobRequirementId], references: [id], onDelete: Restrict)

  @@index([blueprintId, active])
}

/// Snapshot rows: name + weight are copied at save time so blueprint edits
/// never rewrite historical scores (§6 immutable audit snapshots).
model EvaluationCompetencyScore {
  id             Int    @id @default(autoincrement())
  evaluationId   Int
  competencyName String
  weightSnapshot Int
  score          Int
  notes          String?

  evaluation Evaluation @relation("EvaluationCompetencyScores", fields: [evaluationId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, competencyName])
}


/// T112: outbound webhook subscription. Partners register a URL and
/// receive signed JSON payloads when subscribed events fire.
model PartnerWebhookSubscription {
  id        Int      @id @default(autoincrement())
  companyId Int
  url       String
  secretEnc String
  events    String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deliveries OutboundWebhookDelivery[]

  @@index([companyId, active])
}

enum OutboundEmailStatus {
  PENDING
  SENT
  FAILED
  /// Content was removed (erasure or retention). Never retried.
  CANCELLED
}

/// Durable outbound email queue. Resend is attempted immediately; failures
/// retry on cron until SENT or attempts are exhausted.
model OutboundEmailAttempt {
  id          Int                 @id @default(autoincrement())
  to          String
  subject     String
  text        String
  html        String
  /// Tenant and candidate the message is about. Null for system mail and for rows queued before these columns existed.
  companyId   Int?
  candidateId Int?
  status      OutboundEmailStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  nextRetryAt DateTime            @default(now())
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, nextRetryAt])
  @@index([companyId, candidateId])
}

enum OutboundWebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/// Outbound partner webhook deliveries with retry. Distinct from inbound
/// ProviderWebhookDelivery (LinkedIn/Indeed).
model OutboundWebhookDelivery {
  id             Int                           @id @default(autoincrement())
  subscriptionId Int
  event          String
  payload        String
  status         OutboundWebhookDeliveryStatus @default(PENDING)
  attempts       Int                           @default(0)
  lastStatusCode Int?
  lastError      String?
  nextRetryAt    DateTime                      @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  subscription PartnerWebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([status, nextRetryAt])
  @@index([subscriptionId])
}


/// T115: Google Calendar OAuth link for an interviewer's User account.
/// Tokens are AES-256-GCM encrypted at rest (HIREIQ_CREDENTIAL_ENCRYPTION_KEY).
model InterviewerCalendarIntegration {
  id                  Int      @id @default(autoincrement())
  userId              Int
  provider            String   @default("GOOGLE")
  /// Space-separated OAuth scopes granted at connect time. Null means the old read-only grant.
  grantedScopes       String?
  calendarId          String   @default("primary")
  accessTokenEnc      String
  refreshTokenEnc     String
  expiresAt           DateTime
  lastSyncedAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation("UserCalendarIntegration", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, provider])
}

model CompanySsoConnection {
  id              Int      @id @default(autoincrement())
  companyId       Int
  provider        String
  /// OIDC or SAML. OIDC is the default for Okta, Azure AD, and Google Workspace.
  protocol        String   @default("OIDC")
  domain          String
  issuer          String
  clientId        String
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([provider, domain])
  @@index([companyId])
}

model WhatsAppOptIn {
  id        Int      @id @default(autoincrement())
  companyId Int
  phoneE164 String
  optedInAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, phoneE164])
}

/// T96 Phase 4: result of checking one PUBLISHED distribution against its
/// provider during a reconciliation sweep. Detection only — never mutates
/// distribution state automatically (auto-heal requires an explicit ticket).
model DistributionReconciliationRun {
  id             Int                     @id @default(autoincrement())
  batchId        String
  distributionId Int
  provider       DistributionProvider
  outcome        ReconciliationOutcome
  expectedStatus ProviderPostingStatus?
  observedStatus ProviderPostingStatus?
  finding        String?
  checkedAt      DateTime                @default(now())

  distribution JobDistribution @relation("DistributionReconciliationRuns", fields: [distributionId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([distributionId, checkedAt])
}

enum ReconciliationOutcome {
  OK
  DRIFT
  ERROR
  SKIPPED
}

enum AiReviewerAction {
  PENDING
  ACCEPTED
  EDITED
  DISMISSED
  OVERRIDDEN
  /// Model was not called. This is not a successful evaluation.
  REFUSED_OPT_OUT
}

enum RequirementOwnershipType {
  REQUIRED
  PREFERRED
}

enum RequirementEvidenceType {
  RESUME
  ASSESSMENT
  INTERVIEW
}

enum RequirementOrigin {
  HUMAN
  AI
}

enum RequirementApprovalStatus {
  DRAFT
  APPROVED
  REJECTED
}

/// Recruiter-facing evidence status. Not a hire score.
enum EvidenceReviewStatus {
  MEETS
  NOT_MET
  UNKNOWN
}

enum WorkflowTrigger {
  STAGE_CHANGE
  TIME_ELAPSED
  FORM_SUBMITTED
  SCORECARD_OVERDUE
}

/// Append-only model call. Tenant admins do not get update or delete paths.
model AIRun {
  id             Int              @id @default(autoincrement())
  companyId      Int
  feature        String
  entityType     String
  entityId       Int
  modelId        String
  promptVersion  String
  inputHash      String
  outputJson     Json
  latencyMs      Int
  promptTokens   Int?
  completionTokens Int?
  /// ok or error. Opt-out does not insert a row.
  status         String           @default("ok")
  error          String?
  reviewerAction AiReviewerAction @default(PENDING)
  reviewerReason String?
  createdAt      DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, feature, createdAt])
  @@index([companyId, entityType, entityId])
}

model CompanyFeatureFlag {
  id        Int      @id @default(autoincrement())
  companyId Int
  feature   String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, feature])
}

model JdLintDismissal {
  id        Int      @id @default(autoincrement())
  companyId Int
  jobId     Int
  ruleId    String
