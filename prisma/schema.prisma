generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum CandidateStatus {
  APPLIED
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  SYSTEM_DESIGN
  HR
}

enum CodingTestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

enum RequirementLifecycle {
  REQUIREMENT_DRAFTED
  CLIENT_NOTIFIED
  REQUIREMENT_POSTED
  INTERVIEWER_NOTIFIED
  SOURCING_SHORTLISTING
  BILLING_GENERATED
}

enum RoleCategory {
  ENGINEERING
  SALES
  DESIGN
  FINANCE
}

enum SourcingDatabaseSource {
  LINKEDIN
  NAUKRI
}

enum InterviewerAvailability {
  AVAILABLE
  NOT_AVAILABLE
}

enum InterviewerCategory {
  ENGINEERING
  DATA_SCIENCE
  PRODUCT
  DESIGN
}

enum ApplicationPipelineStatus {
  CV_POOL
  EXPERT_REVIEW
  TECH_EVALUATION
  SHORTLISTED
  SELECTED
  REJECTED
  HIRED
}

enum EvaluationFitDecision {
  RIGHT_FIT
  NOT_FIT
}

enum NotificationType {
  INTERVIEWER_REQUIREMENT_READY
}

enum PortalRole {
  ADMIN
  CLIENT
  INTERVIEWER
}

/// Internal billing foundation states only.
/// Payment processing is NOT implemented.
enum BillingStatus {
  PENDING
  READY
  INVOICED
  PAID
  CANCELLED
}

model Company {
  id        Int    @id @default(autoincrement())
  name      String
  industry  String
  employees Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates     Candidate[]
  jobs           Job[]
  users          User[]
  billingRecords BillingRecord[]
}

model Job {
  id     Int       @id @default(autoincrement())
  title  String
  status JobStatus @default(OPEN)

  roleCategory        RoleCategory?
  experienceRange     String?
  location            String?
  compensationRange   String?
  targetHireDate      DateTime?
  numberOfPositions   Int?
  mustHaveRequirements String?
  niceToHaveRequirements String?
  jobDescription      String?
  evaluationCriteria  String?
  primarySkills       String?

  requirementLifecycle RequirementLifecycle @default(REQUIREMENT_DRAFTED)
  clientCompletedAt    DateTime?

  sourcingDatabaseSource SourcingDatabaseSource?
  sourcingAccessDetails  String?

  sourcingAccessReceivedAt DateTime?
  shortlistingDueAt        DateTime?
  shortlistingCompletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int
  assignedInterviewerId Int?

  company      Company        @relation(fields: [companyId], references: [id])
  assignedInterviewer Interviewer? @relation(fields: [assignedInterviewerId], references: [id], onDelete: Restrict)
  applications Application[]
  notifications Notification[]
  billingRecords BillingRecord[]

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([assignedInterviewerId])
}

/// Requirement-scoped billing foundation record.
/// No payment amounts, currency, or gateway fields.
model BillingRecord {
  id     Int           @id @default(autoincrement())
  status BillingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int
  jobId     Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([jobId])
  @@index([status])
}

model Interviewer {
  id           Int                     @id @default(autoincrement())
  name         String
  category     InterviewerCategory
  availability InterviewerAvailability @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedJobs Job[]
  evaluations  Evaluation[]
  notifications Notification[]
  users         User[]
}

model Candidate {
  id              Int             @id @default(autoincrement())
  name            String
  role            String
  experienceYears Int
  status          CandidateStatus
  location        String?
  currentEmployer String?
  skills          String?
  expectedCTC     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int

  company      Company        @relation(fields: [companyId], references: [id])
  applications Application[]

  @@unique([id, companyId])
  @@index([companyId])
}

model Application {
  id Int @id @default(autoincrement())

  status ApplicationPipelineStatus @default(CV_POOL)
  source SourcingDatabaseSource?
  expertScore Int?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateId Int
  jobId       Int
  /// Denormalized tenant key enforcing Candidate.companyId === Job.companyId
  /// via composite foreign keys (database defense-in-depth).
  companyId   Int

  candidate Candidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Restrict)
  job       Job       @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict)
  interviews Interview[]
  codingTests CodingTest[]
  reports     Report[]
  evaluations Evaluation[]

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId, status])
  @@index([companyId])
}

model Evaluation {
  id Int @id @default(autoincrement())

  overallScore    Int?
  scorecard       Json?
  notes           String?
  recordingUrl    String?
  recommendation  Recommendation?
  hireProbability String?
  fitDecision     EvaluationFitDecision?
  evaluatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId Int
  interviewerId Int

  application Application @relation(fields: [applicationId], references: [id])
  interviewer Interviewer @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  questions   EvaluationQuestion[]

  @@unique([applicationId, interviewerId])
  @@index([applicationId])
  @@index([interviewerId])
}

model EvaluationQuestion {
  id Int @id @default(autoincrement())

  question      String
  answer        String?
  expertComment String?
  score         Int?
  difficulty    String?
  weight        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluationId Int

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  @@index([evaluationId])
}

model Interview {
  id          Int             @id @default(autoincrement())
  type        InterviewType
  interviewAt DateTime
  result      InterviewResult

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}

model CodingTest {
  id Int @id @default(autoincrement())

  title String

  score Int

  maxScore Int

  status CodingTestStatus

  takenAt DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}

model Report {
  id Int @id @default(autoincrement())

  recommendation Recommendation

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  applicationId Int

  application Application @relation(fields: [applicationId], references: [id])
  @@index([applicationId])
}

model Notification {
  id Int @id @default(autoincrement())

  type NotificationType

  message String

  createdAt DateTime @default(now())

  jobId Int
  interviewerId Int

  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  interviewer Interviewer @relation(fields: [interviewerId], references: [id], onDelete: Restrict)

  @@unique([jobId, interviewerId, type])
  @@index([jobId])
  @@index([interviewerId])
  @@index([type])
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String
  role         PortalRole
  /// bcrypt hash — never expose to clients
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId     Int?
  interviewerId Int? @unique

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interviewer Interviewer? @relation(fields: [interviewerId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([role])
}
