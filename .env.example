# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Auth.js / NextAuth (required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: public app URL for Auth.js in some deployments
# AUTH_URL="http://localhost:3000"

# Public application URL used in interviewer email links (T68) and hosted apply URLs (T84).
# Prefer this over AUTH_URL. Do not rely on hardcoded localhost in production.
# Required to publish a HIREIQ_HOSTED distribution.
# APP_URL="https://app.example.com"

# Optional Resend email delivery for requirement-ready interviewer emails (T68).
# Leave unset in local development — HireIQ will not send real email.
# RESEND_API_KEY=""
# EMAIL_FROM="HireIQ <notifications@example.com>"

# Optional OpenAI job-description generation (T82).
# Leave unset in local development — HireIQ will not call a live provider.
# OPENAI_API_KEY=""
# OPENAI_JOB_DESCRIPTION_MODEL="gpt-4o-mini"
# Optional OpenAI candidate-intelligence extraction (T92). Reuses OPENAI_API_KEY.
# Leave unset in local development — HireIQ will not call a live provider.
# OPENAI_CANDIDATE_INTELLIGENCE_MODEL="gpt-4o-mini"

# T86: HMAC secret for POST /api/webhooks/linkedin (HireIQ webhook seam).
# Leave unset — the route fails closed. Not a live LinkedIn partner credential.
# LINKEDIN_WEBHOOK_SECRET=""

# T87: HMAC-SHA1 secret for POST /api/webhooks/indeed (Indeed Apply).
# Leave unset — the route fails closed. Not a live Indeed Job Sync / OAuth credential.
# INDEED_APPLY_WEBHOOK_SECRET=""
# Generate with: openssl rand -base64 32
# Required to create or update provider connections. Leave unset if unused —
# connection create/update fails safely; the rest of HireIQ still works.
# Never commit a real key. Never put this value in the browser or JWT.
# HIREIQ_CREDENTIAL_ENCRYPTION_KEY=""

# Admin bootstrap (development only — never commit real values)
# Run: pnpm db:bootstrap-admin
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Local fixture bootstrap (development only — never commit real values)
# Creates 6 companies with owner/member client logins, 5 interviewer accounts,
# 4 posted requirements per company, and pipeline candidates for local testing.
# Run: pnpm db:bootstrap-dev
# Falls back to ADMIN_PASSWORD when unset.
BOOTSTRAP_PASSWORD=""
