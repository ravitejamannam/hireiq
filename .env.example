# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Auth.js / NextAuth (required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: public app URL for Auth.js in some deployments
# AUTH_URL="http://localhost:3000"

# Public application URL used in interviewer email links (T68) and hosted apply URLs (T84).
# Prefer this over AUTH_URL. Do not rely on hardcoded localhost in production.
# Required to publish a HIREIQ_HOSTED distribution.
# APP_URL="https://app.example.com"

# Optional Resend email delivery for requirement-ready interviewer emails (T68).
# Leave unset in local development — HireIQ will not send real email.
# RESEND_API_KEY=""
# EMAIL_FROM="HireIQ <notifications@example.com>"

# Optional OpenAI job-description generation (T82).
# Leave unset in local development — HireIQ will not call a live provider.
# OPENAI_API_KEY=""
# OPENAI_JOB_DESCRIPTION_MODEL="gpt-4o-mini"
# Optional OpenAI candidate-intelligence extraction (T92). Reuses OPENAI_API_KEY.
# Leave unset in local development — HireIQ will not call a live provider.
# OPENAI_CANDIDATE_INTELLIGENCE_MODEL="gpt-4o-mini"

# T86: HMAC secret for POST /api/webhooks/linkedin (HireIQ webhook seam).
# Leave unset — the route fails closed. Not a live LinkedIn partner credential.
# LINKEDIN_WEBHOOK_SECRET=""

# T87: HMAC-SHA1 secret for POST /api/webhooks/indeed (Indeed Apply).
# Leave unset — the route fails closed. Not a live Indeed Job Sync / OAuth credential.
# INDEED_APPLY_WEBHOOK_SECRET=""
# Generate with: openssl rand -base64 32
# Required to create or update provider connections. Leave unset if unused —
# connection create/update fails safely; the rest of HireIQ still works.
# Never commit a real key. Never put this value in the browser or JWT.
# HIREIQ_CREDENTIAL_ENCRYPTION_KEY=""

# Admin bootstrap (development only — never commit real values)
# Run: pnpm db:bootstrap-admin
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Local fixture bootstrap (development only — never commit real values)
# Creates 6 companies with owner/member client logins, 5 interviewer accounts,
# 4 posted requirements per company, and pipeline candidates for local testing.
# Run: pnpm db:bootstrap-dev
# Falls back to ADMIN_PASSWORD when unset.
BOOTSTRAP_PASSWORD=""

# ── T96+ distribution platform additions ─────────────────────────────
# Public origin used to build hosted-apply URLs, public job pages, and
# XML feed links. Must match the port `pnpm dev` binds (`next dev -p 4000`).
APP_URL="http://localhost:4000"

# HMAC signing key for per-company public feed tokens (/feeds/jobs.xml).
# Rotating this revokes all feed tokens at once. Falls back to AUTH_SECRET
# when unset. Generate: openssl rand -base64 32
FEED_SIGNING_KEY=""

# Cron: Vercel Cron sends GET with Authorization: Bearer $CRON_SECRET.
# Hobby only allows one run per day (see vercel.json). Used by
# /api/digest/send and /api/ops/cron (email + webhook retries).
CRON_SECRET=""

# Secret for cron-triggered reconciliation sweeps:
#   POST /api/integrations/reconcile with header `x-cron-secret`
#   or Authorization: Bearer $CRON_SECRET.
# Leave unset to allow admin-session triggers only (fail closed for cron).
RECONCILIATION_SECRET=""

# Resume storage. LOCAL writes under .data/resumes (dev).
# Production: S3 (AWS, Cloudflare R2, MinIO).
RESUME_STORAGE_DRIVER="LOCAL"
RESUME_STORAGE_DIR=".data/resumes"
# S3_BUCKET=""
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Optional custom endpoint for R2/MinIO:
# S3_ENDPOINT="https://ACCOUNT.r2.cloudflarestorage.com"

# Google Calendar (T115). Leave unset — connect UI stays fail-closed.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:4000/api/integrations/google/callback"

# Optional Sentry DSN for error reporting (no SDK required).
# SENTRY_DSN=""

# Production-only: allow http APP_URL (staging). Never set on the public internet.
# ALLOW_INSECURE_APP_URL=""
