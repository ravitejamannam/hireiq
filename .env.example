# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Auth.js / NextAuth (required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: public app URL for Auth.js in some deployments
# AUTH_URL="http://localhost:3000"

# Admin bootstrap (development only — never commit real values)
# Run: pnpm db:bootstrap-admin
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
